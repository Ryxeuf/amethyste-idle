{% extends 'game/game.html.twig' %}

{% block title %}Console MJ{% endblock %}

{% block game_content %}
<div class="game-page max-w-3xl mx-auto space-y-4">

    {# ── Etat ──────────────────────────────────────────── #}
    <div class="ds-card p-4">
            <div class="flex items-center gap-2 flex-wrap mb-2">
                <span class="ds-seal ds-seal-amethyst">MJ</span>
                <h2 class="ds-title">Console du maitre du jeu</h2>
            </div>
            <p class="ds-hint mb-3">
                Zone courante : <strong>{{ zone ? zone.localizedName(app.request.locale) : 'aucune' }}</strong>.
                Tout ce qui suit s'applique ici.
            </p>

            <div class="flex items-center justify-between gap-3 border-t border-line pt-3">
                <div>
                    <div class="ds-label">Visibilite</div>
                    <div class="text-sm">
                        {% if player.gameMasterIncognito %}
                            <span class="ds-seal ds-seal--loss">Incognito</span>
                            <span class="ds-hint">Vous n'apparaissez ni dans la presence de zone, ni dans la recherche de joueurs.</span>
                        {% else %}
                            <span class="ds-seal ds-seal-amethyst">Visible</span>
                            <span class="ds-hint">Les joueurs vous voient et vous reconnaissent comme MJ.</span>
                        {% endif %}
                    </div>
                </div>
                <form method="post" action="{{ path('app_game_gm_incognito') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('gm_incognito') }}">
                    <button type="submit" class="ds-btn ds-btn--secondary ds-btn--sm whitespace-nowrap">
                        {{ player.gameMasterIncognito ? 'Redevenir visible' : 'Passer incognito' }}
                    </button>
                </form>
            </div>
    </div>

    {# ── Annonce globale ───────────────────────────────── #}
    <div class="ds-card p-4">
            <h3 class="ds-label mb-2">Annonce globale</h3>
            <p class="ds-hint mb-2">Diffusee a tout le serveur, sur le canal general.</p>
            <form method="post" action="{{ path('app_game_gm_announce') }}" class="flex gap-2">
                <input type="hidden" name="_token" value="{{ csrf_token('gm_announce') }}">
                <input type="text" name="content" maxlength="500" required
                       placeholder="Ce que le monde doit entendre…"
                       class="flex-1 min-w-0 rounded-card bg-paper border border-line px-3 py-2 text-sm text-ink focus:outline-hidden focus:border-brand">
                <button type="submit" class="ds-btn ds-btn--primary ds-btn--sm shrink-0">Annoncer</button>
            </form>

            {% if announcements|length > 0 %}
                <ul class="mt-3 space-y-1 border-t border-line pt-3">
                    {% for message in announcements %}
                        <li class="text-xs">
                            <span class="ds-num ds-num--sm ds-num--muted mr-1">{{ message.createdAt ? message.createdAt|date('d/m H:i') : '' }}</span>
                            <span class="font-semibold mr-1">{{ message.sender.name }} :</span>
                            <span class="ds-hint">{{ message.content }}</span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
    </div>

    {# ── Faire apparaitre des monstres ─────────────────── #}
    <div class="ds-card p-4">
            <h3 class="ds-label mb-2">Faire apparaitre des monstres</h3>
            {% if zone is null %}
                <div class="ds-empty">
                    <p class="ds-empty__hint">Rejoignez une zone pour y poser des monstres.</p>
                </div>
            {% else %}
                <p class="ds-hint mb-2">
                    Monstres ordinaires — meme vie, meme niveau, meme butin que ceux du vivier.
                    {{ maxSpawn }} au maximum par geste.
                </p>
                <form method="post" action="{{ path('app_game_gm_spawn') }}" class="flex flex-col sm:flex-row gap-2">
                    <input type="hidden" name="_token" value="{{ csrf_token('gm_spawn') }}">
                    <select name="monster_id" required
                            class="flex-1 min-w-0 rounded-card bg-paper border border-line px-3 py-2 text-sm text-ink">
                        {% for monster in monsters %}
                            <option value="{{ monster.id }}">{{ monster.name }} (niv. {{ monster.level }})</option>
                        {% endfor %}
                    </select>
                    <input type="number" name="count" value="1" min="1" max="{{ maxSpawn }}"
                           class="w-full sm:w-20 rounded-card bg-paper border border-line px-3 py-2 text-sm text-ink">
                    <button type="submit" class="ds-btn ds-btn--secondary ds-btn--sm shrink-0">Poser</button>
                </form>
            {% endif %}
    </div>

    {# ── Evenements de la zone ─────────────────────────── #}
    <div class="ds-card p-4">
            <h3 class="ds-label mb-2">Evenements de la zone</h3>
            {% if zoneEvents|length == 0 %}
                <div class="ds-empty">
                    <p class="ds-empty__hint">Aucun evenement rattache a cette zone. Ils se creent depuis l'administration.</p>
                </div>
            {% else %}
                <ul class="space-y-1.5">
                    {% for event in zoneEvents %}
                        <li class="ds-row">
                            <span class="ds-row__body">
                                <span class="ds-row__name ds-name--sm">{{ event.name }}</span>
                                <span class="ds-hint">
                                    {{ event.type }} ·
                                    {% if event.status == 'active' %}
                                        <span class="ds-num--gain">en cours jusqu'a {{ event.endsAt|date('H:i') }}</span>
                                    {% else %}
                                        {{ event.status }}
                                    {% endif %}
                                </span>
                            </span>
                            <form method="post" action="{{ path('app_game_gm_event', {id: event.id, action: event.status == 'active' ? 'stop' : 'launch'}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('gm_event_' ~ event.id) }}">
                                <button type="submit" class="ds-btn ds-btn--quiet ds-btn--sm">
                                    {{ event.status == 'active' ? 'Clore' : 'Lancer' }}
                                </button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
    </div>

    {# ── Canal de service ──────────────────────────────── #}
    <div class="ds-card p-4">
            <h3 class="ds-label mb-2">Canal MJ</h3>
            <p class="ds-hint mb-2">Entre animateurs. Aucun joueur ne le lit.</p>
            <div class="max-h-48 overflow-y-auto border border-line rounded-card px-3 py-2 mb-2">
                {% if gmMessages|length == 0 %}
                    <p class="ds-hint">Rien pour l'instant.</p>
                {% else %}
                    {% for message in gmMessages %}
                        <div class="text-xs py-0.5">
                            <span class="ds-num ds-num--sm ds-num--muted mr-1">{{ message.createdAt ? message.createdAt|date('H:i') : '' }}</span>
                            <span class="font-semibold text-brand mr-1">{{ message.sender.name }} :</span>
                            <span class="text-ink">{{ message.content }}</span>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
            <form method="post" action="{{ path('app_game_gm_say') }}" class="flex gap-2">
                <input type="hidden" name="_token" value="{{ csrf_token('gm_say') }}">
                <input type="text" name="content" maxlength="500" required
                       class="flex-1 min-w-0 rounded-card bg-paper border border-line px-3 py-2 text-sm text-ink focus:outline-hidden focus:border-brand">
                <button type="submit" class="ds-btn ds-btn--secondary ds-btn--sm shrink-0">Envoyer</button>
            </form>
    </div>

    <p class="ds-hint">
        Chacun de ces gestes est inscrit au journal d'administration, sous votre nom.
    </p>
</div>
{% endblock %}
