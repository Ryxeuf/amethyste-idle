{% extends 'game/game.html.twig' %}

{% block title %}Ma demeure{% endblock %}

{% block game_content %}
<div class="game-page">
    <div class="game-card">
        <div class="game-card-header">
            <h2 class="text-base sm:text-lg font-semibold text-white">
                {{ house ? house.name : 'Acquerir une demeure' }}
            </h2>
            <p class="text-gray-400 text-xs mt-0.5">
                {% if house %}
                    {{ house.zone.localizedName(app.request.locale) }} · acquise le {{ house.purchasedAt|date('d/m/Y') }}
                {% else %}
                    Un terrain s'achete sur place, dans un quartier residentiel.
                {% endif %}
            </p>
        </div>

        <div class="game-card-body">
            {% if house %}
                <form method="post" action="{{ path('app_game_house_rename') }}" class="flex flex-wrap items-end gap-2 mb-5">
                    <input type="hidden" name="_token" value="{{ csrf_token('house_rename') }}">
                    <div class="grow min-w-48">
                        <label for="house_name" class="block text-xs text-gray-400 mb-1">Nom de la demeure</label>
                        <input type="text" name="name" id="house_name" maxlength="60" required value="{{ house.name }}"
                               class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-gray-200">
                    </div>
                    <button type="submit" class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-white text-sm rounded-lg transition-colors">Renommer</button>
                </form>

                <p class="text-xs text-gray-500">
                    Le jardin, l'atelier et les visites arrivent dans les jalons suivants.
                </p>
            {% elseif canBuyHere %}
                <div class="flex items-center gap-1.5 mb-4 bg-yellow-900/20 border border-yellow-700/30 rounded-lg px-3 py-2 w-fit">
                    <span class="text-sm font-semibold text-yellow-400">{{ player.gils|number_format(0, ',', ' ') }} Gils</span>
                    <span class="text-xs text-gray-500">/ {{ landPrice|number_format(0, ',', ' ') }} requis</span>
                </div>

                <form method="post" action="{{ path('app_game_house_buy') }}" class="flex flex-wrap items-end gap-2">
                    <input type="hidden" name="_token" value="{{ csrf_token('house_buy') }}">
                    <div class="grow min-w-48">
                        <label for="buy_name" class="block text-xs text-gray-400 mb-1">Nom de votre future demeure</label>
                        <input type="text" name="name" id="buy_name" maxlength="60" required placeholder="Le Repos du Forgeron"
                               class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-gray-200">
                    </div>
                    <button type="submit" {{ player.gils >= landPrice ? '' : 'disabled' }}
                            class="px-4 py-2 bg-green-600 hover:bg-green-500 disabled:bg-gray-700 disabled:cursor-not-allowed text-white text-sm rounded-lg transition-colors">
                        Acheter le terrain
                    </button>
                </form>
            {% else %}
                <p class="text-sm text-gray-500 py-6 text-center">
                    Aucun terrain a vendre ici. Rendez-vous au <strong>Quartier des Jardins</strong> depuis le
                    <a href="{{ path('app_game_world_map') }}" class="text-indigo-400 hover:text-indigo-300">plan du monde</a>.
                </p>
            {% endif %}
        </div>
    </div>

    {% if neighbours is not empty %}
        <div class="game-card mt-4">
            <div class="game-card-header">
                <h3 class="text-sm font-semibold text-white">Le voisinage</h3>
                <p class="text-gray-400 text-xs mt-0.5">Les demeures batties dans cette zone.</p>
            </div>
            <div class="game-card-body">
                <div class="space-y-1.5">
                    {% for neighbour in neighbours %}
                        <div class="bg-gray-900/60 border border-gray-800 rounded-lg px-3 py-2 flex items-center justify-between gap-3">
                            <span class="text-sm text-gray-100 truncate">{{ neighbour.name }}</span>
                            <span class="text-xs text-gray-500 shrink-0">{{ neighbour.owner.name }}</span>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
