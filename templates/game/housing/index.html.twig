{% extends 'game/game.html.twig' %}

{% block title %}Ma demeure{% endblock %}

{% block game_content %}
<div class="game-page">
    <div class="game-card">
        <div class="game-card-header">
            <h2 class="text-base sm:text-lg font-semibold text-white">
                {{ house ? house.name : 'Acquerir une demeure' }}
            </h2>
            <p class="text-gray-400 text-xs mt-0.5">
                {% if house %}
                    {{ house.zone.localizedName(app.request.locale) }} · {{ house.style.label }} · acquise le {{ house.purchasedAt|date('d/m/Y') }}
                    {% if house.motto %}<br><em class="text-gray-500">« {{ house.motto }} »</em>{% endif %}
                {% else %}
                    Un terrain s'achete sur place, dans un quartier residentiel.
                {% endif %}
            </p>
        </div>

        <div class="game-card-body">
            {% if house %}
                <form method="post" action="{{ path('app_game_house_rename') }}" class="flex flex-wrap items-end gap-2 mb-5">
                    <input type="hidden" name="_token" value="{{ csrf_token('house_rename') }}">
                    <div class="grow min-w-48">
                        <label for="house_name" class="block text-xs text-gray-400 mb-1">Nom de la demeure</label>
                        <input type="text" name="name" id="house_name" maxlength="60" required value="{{ house.name }}"
                               class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-gray-200">
                    </div>
                    <button type="submit" class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-white text-sm rounded-lg transition-colors">Renommer</button>
                </form>

                {# HOU-05 : le coffre et l'atelier existent deja ailleurs — la
                   demeure les rassemble, elle ne les enferme pas. #}
                <div class="grid gap-2 sm:grid-cols-2 mb-4">
                    <a href="{{ path('app_game_inventory') }}" class="bg-gray-900/60 hover:bg-gray-800/60 border border-gray-800 rounded-lg p-3 transition-colors">
                        <p class="text-sm text-gray-100">Le coffre</p>
                        <p class="text-xs text-gray-500 mt-0.5">{{ bankInventory.items|length }} / {{ bankInventory.size }} emplacements occupes</p>
                    </a>
                    <a href="{{ path('app_game_craft') }}" class="bg-gray-900/60 hover:bg-gray-800/60 border border-gray-800 rounded-lg p-3 transition-colors">
                        <p class="text-sm text-gray-100">L'atelier</p>
                        <p class="text-xs text-gray-500 mt-0.5">
                            {% if activeJob %}
                                {{ activeJob.quantity }}x {{ activeJob.recipe.result.name }} — {{ activeJob.remainingSeconds }}s
                            {% else %}
                                Aucun ouvrage en cours
                            {% endif %}
                        </p>
                    </a>
                </div>

                {# HOU-04 : le loyer est un gold sink recurrent. Une demeure en
                   arriere dort — rien n'est confisque. #}
                <div class="mb-4 rounded-lg px-3 py-2 flex flex-wrap items-center justify-between gap-3
                            {{ house.inArrears ? 'bg-red-950/40 border border-red-800/50' : 'bg-gray-900/60 border border-gray-800' }}">
                    <div>
                        <p class="text-xs {{ house.inArrears ? 'text-red-300' : 'text-gray-400' }}">
                            {% if house.inArrears %}
                                Loyer en retard depuis le {{ house.rentDueAt|date('d/m/Y') }} — le jardin est a l'abandon.
                            {% else %}
                                Prochain loyer : {{ house.rentDueAt|date('d/m/Y') }}
                            {% endif %}
                        </p>
                        <p class="text-xs text-gray-600 mt-0.5">{{ rentAmount|number_format(0, ',', ' ') }} Gils par semaine. Rien n'est jamais confisque.</p>
                    </div>
                    <form method="post" action="{{ path('app_game_house_rent') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('house_rent') }}">
                        <button type="submit" {{ player.gils >= rentAmount ? '' : 'disabled' }}
                                class="px-3 py-1.5 text-xs rounded-lg bg-amber-700 hover:bg-amber-600 disabled:bg-gray-700 disabled:cursor-not-allowed text-ink-on transition-colors">
                            Payer le loyer
                        </button>
                    </form>
                </div>

                {# HOU-02 : le jardin pousse en temps reel, sans energie et sans
                   presence. C'est le pilier PBBG du housing. #}
                <h3 class="text-sm font-semibold text-emerald-300 mb-2">Le jardin</h3>
                <div class="grid gap-2 sm:grid-cols-2">
                    {% for plot in plots %}
                        <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
                            {% if plot.empty %}
                                {% if plantableStock is empty %}
                                    <p class="text-xs text-gray-500">Parcelle en friche. Recoltez des plantes dehors pour en semer ici.</p>
                                {% else %}
                                    <form method="post" action="{{ path('app_game_house_plant', {id: plot.id}) }}" class="flex items-end gap-2">
                                        <input type="hidden" name="_token" value="{{ csrf_token('garden_plant_' ~ plot.id) }}">
                                        <div class="grow">
                                            <label class="block text-xs text-gray-500 mb-1">Parcelle {{ plot.position + 1 }}</label>
                                            <select name="crop" class="w-full px-2 py-1.5 bg-gray-800 border border-gray-700 rounded text-xs text-gray-200">
                                                {% for entry in plantableStock %}
                                                    <option value="{{ entry.item.slug }}">{{ entry.item.name }} ({{ entry.count }})</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                        <button type="submit" class="px-3 py-1.5 text-xs rounded bg-emerald-700 hover:bg-emerald-600 text-ink-on transition-colors">Semer</button>
                                    </form>
                                {% endif %}
                            {% else %}
                                <div class="flex items-center justify-between gap-3">
                                    <div class="min-w-0">
                                        <p class="text-sm text-gray-100 truncate">{{ plot.crop.name }}</p>
                                        <p class="text-xs text-gray-500 mt-0.5">
                                            {% if plot.ripe %}A maturite{% else %}Pousse encore {{ (plot.remainingSeconds / 60)|round(0, 'ceil') }} min{% endif %}
                                        </p>
                                    </div>
                                    {% if plot.ripe %}
                                        <form method="post" action="{{ path('app_game_house_harvest', {id: plot.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('garden_harvest_' ~ plot.id) }}">
                                            <button type="submit" class="px-3 py-1.5 text-xs rounded bg-emerald-700 hover:bg-emerald-600 text-ink-on transition-colors">Recolter</button>
                                        </form>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>

                <p class="text-xs text-gray-600 mt-3">
                    Une parcelle rend 2 a 3 unites de ce qu'on y seme, en 3 heures.
                </p>

                {# HOU-05 : l'ameublement se paie, la devise non. ECO-30 : un
                   necessaire d'ameublement du charpentier remplace le prix. #}
                <h3 class="text-sm font-semibold text-indigo-300 mt-5 mb-2">Ameublement</h3>
                <p class="text-xs text-gray-500 mb-2">{{ 'game.housing.furnishing_kit_hint'|trans }}</p>
                <div class="grid gap-2 sm:grid-cols-2">
                    {% for style in styles %}
                        <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3 flex items-center justify-between gap-3">
                            <div class="min-w-0">
                                <p class="text-sm text-gray-100">{{ style.label }}</p>
                                <p class="text-xs text-gray-500 mt-0.5">{{ style.description }}</p>
                            </div>
                            {% if house.style == style %}
                                <span class="text-xs text-emerald-400 shrink-0">Installe</span>
                            {% else %}
                                <form method="post" action="{{ path('app_game_house_furnish') }}" class="shrink-0">
                                    <input type="hidden" name="_token" value="{{ csrf_token('house_furnish') }}">
                                    <input type="hidden" name="style" value="{{ style.value }}">
                                    <button type="submit" {{ player.gils >= style.price ? '' : 'disabled' }}
                                            class="px-3 py-1.5 text-xs rounded-lg bg-indigo-600 hover:bg-indigo-500 disabled:bg-gray-700 disabled:cursor-not-allowed text-ink-on transition-colors">
                                        {{ style.price|number_format(0, ',', ' ') }} G
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>

                <form method="post" action="{{ path('app_game_house_motto') }}" class="flex flex-wrap items-end gap-2 mt-4">
                    <input type="hidden" name="_token" value="{{ csrf_token('house_motto') }}">
                    <div class="grow min-w-48">
                        <label for="house_motto" class="block text-xs text-gray-400 mb-1">Devise du fronton (gratuite)</label>
                        <input type="text" name="motto" id="house_motto" maxlength="140" value="{{ house.motto }}"
                               class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-gray-200">
                    </div>
                    <button type="submit" class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-white text-sm rounded-lg transition-colors">Graver</button>
                </form>
            {% elseif canBuyHere %}
                <div class="flex items-center gap-1.5 mb-4 bg-yellow-900/20 border border-yellow-700/30 rounded-lg px-3 py-2 w-fit">
                    <span class="text-sm font-semibold text-yellow-400">{{ player.gils|number_format(0, ',', ' ') }} Gils</span>
                    <span class="text-xs text-gray-500">/ {{ landPrice|number_format(0, ',', ' ') }} requis</span>
                </div>

                <form method="post" action="{{ path('app_game_house_buy') }}" class="flex flex-wrap items-end gap-2">
                    <input type="hidden" name="_token" value="{{ csrf_token('house_buy') }}">
                    <div class="grow min-w-48">
                        <label for="buy_name" class="block text-xs text-gray-400 mb-1">Nom de votre future demeure</label>
                        <input type="text" name="name" id="buy_name" maxlength="60" required placeholder="Le Repos du Forgeron"
                               class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-gray-200">
                    </div>
                    <button type="submit" {{ player.gils >= landPrice ? '' : 'disabled' }}
                            class="px-4 py-2 bg-green-600 hover:bg-green-500 disabled:bg-gray-700 disabled:cursor-not-allowed text-ink-on text-sm rounded-lg transition-colors">
                        Acheter le terrain
                    </button>
                </form>
            {% else %}
                <p class="text-sm text-gray-500 py-6 text-center">
                    Aucun terrain a vendre ici. Rendez-vous au <strong>Quartier des Jardins</strong> — ou dans un foyer au rang de Hameau ou plus — depuis le
                    <a href="{{ path('app_game_world_map') }}" class="text-indigo-400 hover:text-indigo-300">plan du monde</a>.
                </p>
            {% endif %}
        </div>
    </div>

    {% if neighbours is not empty %}
        <div class="game-card mt-4">
            <div class="game-card-header">
                <h3 class="text-sm font-semibold text-white">Le voisinage</h3>
                <p class="text-gray-400 text-xs mt-0.5">Les demeures batties dans cette zone.</p>
            </div>
            <div class="game-card-body">
                <div class="space-y-1.5">
                    {% for neighbour in neighbours %}
                        <a href="{{ path('app_game_house_visit', {id: neighbour.id}) }}"
                           class="bg-gray-900/60 hover:bg-gray-800/60 border border-gray-800 rounded-lg px-3 py-2 flex items-center justify-between gap-3 transition-colors">
                            <span class="text-sm text-gray-100 truncate">{{ neighbour.name }}</span>
                            <span class="text-xs text-gray-500 shrink-0">{{ neighbour.owner.name }}</span>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
