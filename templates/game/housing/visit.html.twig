{% extends 'game/game.html.twig' %}

{% block title %}{{ house.name }}{% endblock %}

{% block game_content %}
<div class="game-page">
    <div class="game-card">
        <div class="game-card-header flex items-center justify-between gap-3">
            <div class="min-w-0">
                <h2 class="text-base sm:text-lg font-semibold text-white truncate">{{ house.name }}</h2>
                <p class="text-gray-400 text-xs mt-0.5">
                    Demeure de {{ house.owner.name }}
                    · {{ house.zone.localizedName(app.request.locale) }}
                    · batie le {{ house.purchasedAt|date('d/m/Y') }}
                </p>
            </div>
            <a href="{{ path('app_game_house') }}" class="px-3 py-1.5 bg-gray-600 hover:bg-gray-500 text-white text-xs sm:text-sm rounded-lg transition-colors shrink-0">
                {{ isOwn ? 'Ma demeure' : 'Retour' }}
            </a>
        </div>

        <div class="game-card-body">
            <h3 class="text-sm font-semibold text-emerald-300 mb-2">Le jardin</h3>

            {# Vue en lecture seule : on regarde pousser, on ne recolte pas. #}
            <div class="grid gap-2 sm:grid-cols-2">
                {% for plot in plots %}
                    <div class="bg-gray-900/60 border border-gray-800 rounded-lg p-3">
                        {% if plot.empty %}
                            <p class="text-xs text-gray-600">Parcelle {{ plot.position + 1 }} — en friche</p>
                        {% else %}
                            <p class="text-sm text-gray-100 truncate">{{ plot.crop.name }}</p>
                            <p class="text-xs text-gray-500 mt-0.5">
                                {% if plot.ripe %}A maturite{% else %}Pousse encore {{ (plot.remainingSeconds / 60)|round(0, 'ceil') }} min{% endif %}
                            </p>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>

            {% if not isOwn %}
                <p class="text-xs text-gray-600 mt-3">
                    Vous etes ici en visite : le jardin de {{ house.owner.name }} ne se recolte que par sa main.
                </p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
