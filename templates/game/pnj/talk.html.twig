{% extends 'game/game.html.twig' %}

{% block title %}{{ pnj.localizedName(app.request.locale) }}{% endblock %}

{% block game_content %}
<div class="game-page">
    <div class="game-card">
        <div class="game-card-header">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <div>
                    <h2 class="text-base sm:text-lg font-semibold text-white" data-testid="pnj-name">
                        {{ pnj.localizedName(app.request.locale) }}
                    </h2>
                    <p class="text-gray-400 text-xs mt-0.5">{{ 'game.pnj.talk.subtitle'|trans }}</p>
                </div>
                <a href="{{ path('app_game_zone') }}"
                   class="inline-flex items-center rounded-md px-2.5 py-1 text-xs font-medium bg-gray-800/60 border border-gray-700 text-gray-300 hover:bg-gray-700/60">
                    {{ 'game.pnj.talk.back'|trans }}
                </a>
            </div>
        </div>

        <div class="game-card-body" data-testid="pnj-dialog">
            {% if node is null %}
                <p class="text-gray-500 text-sm">{{ 'game.pnj.talk.silent'|trans }}</p>
            {% else %}
                <div class="flex gap-3">
                    {% if pnj.portrait %}
                        <img src="{{ asset('images/' ~ pnj.portrait) }}" alt="{{ pnj.localizedName(app.request.locale) }}"
                             class="w-16 h-16 rounded-lg border border-gray-700 object-cover shrink-0">
                    {% endif %}
                    <p class="text-sm text-gray-200 leading-relaxed" data-testid="pnj-dialog-text">
                        {{ node.text|default('') }}
                    </p>
                </div>

                <div class="mt-4 space-y-1.5">
                    {% for choice in choices %}
                        {% if choice.action|default('') == 'open_shop' and pnj.isMerchant %}
                            <a href="{{ path('app_game_shop', {id: pnj.id}) }}"
                               data-testid="pnj-dialog-choice"
                               class="block w-full text-left rounded-md px-3 py-2 text-sm bg-amber-900/30 border border-amber-700/50 text-amber-100 hover:bg-amber-800/40">
                                {{ choice.text|default('game.pnj.talk.shop'|trans) }}
                            </a>
                        {% elseif hasNextNode %}
                            <a href="{{ path('app_game_pnj_talk', {id: pnj.id, node: nodeIndex + 1}) }}"
                               data-testid="pnj-dialog-choice"
                               class="block w-full text-left rounded-md px-3 py-2 text-sm bg-gray-800/50 border border-gray-700 text-gray-200 hover:bg-gray-700/50">
                                {{ choice.text|default('game.pnj.talk.next'|trans) }}
                            </a>
                        {% endif %}
                    {% endfor %}

                    {% if choices is empty and hasNextNode %}
                        <a href="{{ path('app_game_pnj_talk', {id: pnj.id, node: nodeIndex + 1}) }}"
                           data-testid="pnj-dialog-choice"
                           class="block w-full text-left rounded-md px-3 py-2 text-sm bg-gray-800/50 border border-gray-700 text-gray-200 hover:bg-gray-700/50">
                            {{ 'game.pnj.talk.next'|trans }}
                        </a>
                    {% endif %}

                    {% if not hasNextNode %}
                        <p class="text-xs text-gray-500 pt-1">{{ 'game.pnj.talk.end'|trans }}</p>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
