{% extends 'game/game.html.twig' %}

{% block title %}Boutique - {{ pnj.name }}{% endblock %}

{% block game_content %}
<div class="game-page">
    <div class="game-card">
        {# Header #}
        <div class="game-card-header flex items-center justify-between">
            <div>
                <h2 class="ds-title">{{ pnj.name }}</h2>
                <p class="ds-hint">
                    Marchand
                    {% if opensAt is not null and closesAt is not null %}
                        <span class="ml-1">({{ opensAt }}h - {{ closesAt }}h)</span>
                    {% endif %}
                    {% if not isOpen %}
                        <span class="ds-seal ds-seal--loss ml-1">— Fermé</span>
                    {% endif %}
                </p>
            </div>
            <div class="flex items-center gap-3">
                <span class="ds-num ds-num--lg" id="player-gils">{{ player.gils }} Gils</span>
                <a href="{{ path('app_game_zone') }}" class="ds-btn ds-btn--quiet ds-btn--sm">Retour</a>
            </div>
        </div>
        <div class="game-card-body">

        {% if not isOpen %}
            <div class="ds-banner ds-banner--loss mb-4">
                <p>La boutique est fermée. Revenez entre {{ opensAt }}h et {{ closesAt }}h.</p>
            </div>
        {% endif %}

        {% if totalDiscount is defined and totalDiscount > 0 %}
            <div class="ds-banner ds-banner--gain mb-4 flex-wrap gap-x-3 gap-y-1">
                <span class="ds-num ds-num--gain">Remise marchand : -{{ (totalDiscount * 100)|round }}%</span>
                {% if renownDiscount > 0 %}
                    <span class="ds-num ds-num--sm">
                        Renommée (<span class="{{ renownTier.cssClass }}">{{ renownTier.label }}</span>) : -{{ (renownDiscount * 100)|round }}%
                    </span>
                {% endif %}
                {% if guildDiscount > 0 %}
                    <span class="ds-num ds-num--sm">Guilde : -{{ (guildDiscount * 100)|round }}%</span>
                {% endif %}
            </div>
        {% endif %}

        {% if hostileSurcharge is defined and hostileSurcharge > 0 %}
            <div class="ds-banner ds-banner--loss mb-4">
                <p>{{ 'game.shop.hostile_surcharge'|trans({'%percent%': hostileSurcharge}) }}</p>
            </div>
        {% endif %}

        {% if shadowsRumorAvailable is defined and shadowsRumorAvailable %}
            {# FAC-06 — le reseau d'oreilles : visible apres le premier contact
               seulement. La vente au receleur passe par l'onglet vendre, aux
               heures du guichet. #}
            <div class="ds-banner mb-4 flex items-center justify-between gap-3">
                <p class="text-xs">{{ 'game.shadows.rumor.offer'|trans({'%price%': shadowsRumorPrice}) }}</p>
                <form method="post" action="{{ path('app_game_shop_rumor', {id: pnj.id}) }}">
                    <button type="submit" class="px-3 py-1.5 text-xs rounded-lg bg-violet-800 hover:bg-violet-700 text-ink-on transition-colors">
                        {{ 'game.shadows.rumor.buy'|trans }}
                    </button>
                </form>
            </div>
        {% endif %}

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            {# Buy section #}
            <div>
                <h3 class="ds-name mb-3 border-b border-line pb-2">Acheter</h3>
                {% if shopItems is empty %}
                    <div class="ds-empty"><p class="ds-empty__hint">Aucun objet en vente.</p></div>
                {% else %}
                    <div class="space-y-2">
                        {% for item in shopItems %}
                            {% set itemStock = stockInfo[item.slug] ?? null %}
                            {% set outOfStock = itemStock is not null and itemStock <= 0 %}
                            {% set effectivePrice = (totalDiscount is defined and totalDiscount > 0) ? (item.price * (1 - totalDiscount))|round(0, 'ceil') : item.price %}
                            {% if hostileSurcharge is defined and hostileSurcharge > 0 %}
                                {% set effectivePrice = ((effectivePrice * (100 + hostileSurcharge)) / 100)|round(0, 'ceil') %}
                            {% endif %}
                            <div class="ds-row ds-edge-{{ item.rarity|default('common') }}{% if outOfStock %} opacity-50{% endif %}"
                                 data-item-slug="{{ item.slug }}">
                                <div class="flex-1 min-w-0">
                                    <span class="ds-row__name ds-name--sm">{{ item|localized_name }}</span>
                                    {% if item.rarity and item.rarity != 'common' %}
                                        <span class="text-[9px] ml-1 inv-tooltip-rarity inv-tooltip-rarity--{{ item.rarity }}">{{ item.rarity|capitalize }}</span>
                                    {% endif %}
                                    {% set itemDescription = item|localized_description %}
                                    <p class="ds-row__meta truncate">{{ itemDescription|slice(0, 60) }}{% if itemDescription|length > 60 %}...{% endif %}</p>
                                </div>
                                <div class="flex items-center gap-3 ml-3">
                                    {% if itemStock is not null %}
                                        <span class="ds-num ds-num--sm {% if outOfStock %}ds-num--loss{% elseif itemStock <= 3 %}ds-num--loss{% else %}ds-num--muted{% endif %}"
                                              id="stock-{{ item.slug }}">
                                            {% if outOfStock %}Rupture{% else %}x{{ itemStock }}{% endif %}
                                        </span>
                                    {% endif %}
                                    <span class="ds-num whitespace-nowrap">
                                        {% if effectivePrice != item.price %}
                                            <span class="ds-num ds-num--sm ds-num--muted line-through mr-1">{{ item.price }}</span>
                                        {% endif %}
                                        {{ effectivePrice }} G
                                    </span>
                                    <button onclick="buyItem('{{ item.slug }}', '{{ item.name }}', {{ effectivePrice }}, {{ pnj.id }})"
                                            class="ds-btn ds-btn--sm touch-target {% if not isOpen or player.gils < effectivePrice or outOfStock %}ds-btn--disabled{% else %}ds-btn--primary{% endif %}"
                                            {% if not isOpen or player.gils < effectivePrice or outOfStock %}disabled{% endif %}
                                            id="buy-btn-{{ item.slug }}">
                                        {% if not isOpen %}Fermé{% elseif outOfStock %}Rupture{% else %}Acheter{% endif %}
                                    </button>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            {# Sell section #}
            <div>
                <h3 class="ds-name mb-3 border-b border-line pb-2">Vendre</h3>
                {% set bag = player.inventories|first %}
                {% if bag and bag.items|length > 0 %}
                    <div class="space-y-2 max-h-96 overflow-y-auto">
                        {% for playerItem in bag.items %}
                            <div class="ds-row ds-edge-{{ playerItem.genericItem.rarity|default('common') }}"
                                 id="sell-item-{{ playerItem.id }}">
                                <div class="flex-1 min-w-0">
                                    <span class="ds-row__name ds-name--sm">{{ playerItem.genericItem|localized_name }}</span>
                                    <span class="ds-row__meta">({{ playerItem.genericItem.type }})</span>
                                </div>
                                <div class="flex items-center gap-3 ml-3">
                                    <span class="ds-num whitespace-nowrap">{{ max(1, (playerItem.genericItem.price * 0.3)|round) }} G</span>
                                    <button onclick="sellItem({{ playerItem.id }}, '{{ playerItem.genericItem.name }}', {{ pnj.id }})"
                                            class="ds-btn ds-btn--secondary ds-btn--sm touch-target">
                                        Vendre
                                    </button>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="ds-empty"><p class="ds-empty__hint">Votre inventaire est vide.</p></div>
                {% endif %}
            </div>
        </div>

        {# Messages area #}
        <div id="shop-messages" class="mt-4 hidden">
            <div class="ds-banner ds-banner--gain" id="shop-message-text"></div>
        </div>
        </div>{# end game-card-body #}
    </div>
</div>

<script>
async function buyItem(slug, name, price, pnjId) {
    try {
        const resp = await fetch(`/game/shop/${pnjId}/buy`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ itemSlug: slug, quantity: 1 }),
        });
        const data = await resp.json();
        if (data.success) {
            showMessage(data.message);
            document.getElementById('player-gils').textContent = data.gils + ' Gils';
            // Update stock display if present
            if (data.stock !== undefined && data.stock !== null) {
                const stockEl = document.getElementById('stock-' + slug);
                const btnEl = document.getElementById('buy-btn-' + slug);
                const rowEl = document.querySelector(`[data-item-slug="${slug}"]`);
                if (stockEl) {
                    if (data.stock <= 0) {
                        stockEl.textContent = 'Rupture';
                        stockEl.className = 'text-xs font-mono whitespace-nowrap text-red-400';
                        if (btnEl) { btnEl.disabled = true; btnEl.textContent = 'Rupture'; btnEl.classList.add('opacity-50', 'cursor-not-allowed'); }
                        if (rowEl) rowEl.classList.add('opacity-50');
                    } else {
                        stockEl.textContent = 'x' + data.stock;
                        stockEl.className = 'text-xs font-mono whitespace-nowrap ' + (data.stock <= 3 ? 'text-orange-400' : 'text-gray-400');
                    }
                }
            }
            // Reload page to update sell list
            setTimeout(() => location.reload(), 800);
        } else {
            showMessage(data.error || 'Erreur', true);
        }
    } catch (e) {
        showMessage('Erreur de connexion', true);
    }
}

async function sellItem(playerItemId, name, pnjId) {
    try {
        const resp = await fetch(`/game/shop/${pnjId}/sell`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ playerItemId }),
        });
        const data = await resp.json();
        if (data.success) {
            showMessage(data.message);
            document.getElementById('player-gils').textContent = data.gils + ' Gils';
            const el = document.getElementById(`sell-item-${playerItemId}`);
            if (el) el.remove();
        } else {
            showMessage(data.error || 'Erreur', true);
        }
    } catch (e) {
        showMessage('Erreur de connexion', true);
    }
}

function showMessage(msg, isError = false) {
    const container = document.getElementById('shop-messages');
    const text = document.getElementById('shop-message-text');
    container.classList.remove('hidden');
    text.textContent = msg;
    text.className = isError
        ? 'bg-red-900/50 border border-red-700 rounded-lg p-3 text-red-300 text-sm'
        : 'bg-green-900/50 border border-green-700 rounded-lg p-3 text-green-300 text-sm';
    setTimeout(() => container.classList.add('hidden'), 3000);
}
</script>
{% endblock %}
