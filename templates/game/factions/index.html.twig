{% extends 'game/game.html.twig' %}

{% block title %}{{ 'game.factions.title'|trans }}{% endblock %}

{% block game_content %}
<div class="game-page">
    <div class="game-card">
        <div class="game-card-header">
            <h2 class="text-base sm:text-lg font-semibold text-white">{{ 'game.factions.title'|trans }}</h2>
        </div>

        <div class="game-card-body">
            {# FAC-01 : la regle avant la liste. Un joueur qui decouvre que sa
               reputation a baisse chez une faction doit pouvoir lire pourquoi
               sans quitter l'ecran. #}
            <div class="mb-4 rounded-lg border border-gray-600 bg-gray-800/40 p-3">
                <p class="text-xs text-gray-300">
                    {{ 'game.factions.axis.explain'|trans({
                        '%tier%': tensionTier.label,
                        '%percent%': tensionPercent
                    }) }}
                </p>
                <p class="mt-2 text-xs text-gray-400">
                    {% if patron %}
                        {{ 'game.factions.patronage.current'|trans({'%faction%': patron.name}) }}
                        <form method="post" action="{{ path('app_game_factions_patron_clear') }}" class="mt-2 inline-block">
                            <input type="hidden" name="_token" value="{{ csrf_token('faction_patron') }}">
                            <button type="submit" class="text-[11px] underline text-gray-400 hover:text-gray-200">
                                {{ 'game.factions.patronage.clear'|trans }}
                            </button>
                        </form>
                    {% else %}
                        {{ 'game.factions.patronage.none'|trans({'%tier%': patronageTier.label}) }}
                    {% endif %}
                </p>
            </div>

            {% if factions is empty %}
                <div class="text-center py-8">
                    <p class="text-gray-500 text-sm">{{ 'game.factions.empty'|trans }}</p>
                </div>
            {% else %}
                <div class="space-y-3">
                    {% for faction in factions %}
                        {% set pf = playerFactionMap[faction.id]|default(null) %}
                        {% set reputation = pf ? pf.reputation : 0 %}
                        {% set tier = pf ? pf.tier : constant('App\\Enum\\ReputationTier::Inconnu') %}
                        {% set nextTier = tier.nextTier %}
                        {% set progressPercent = pf ? pf.progressPercent : 0 %}
                        {% set rewards = rewardsByFaction[faction.id]|default([]) %}

                        <div class="bg-gray-700/50 rounded-lg p-4 border border-gray-600">
                            <div class="flex items-start justify-between gap-3 mb-2">
                                <div class="min-w-0">
                                    <h3 class="text-white font-semibold text-sm sm:text-base">{{ faction|localized_faction_name }}</h3>
                                    <p class="text-gray-400 text-xs sm:text-sm mt-0.5">{{ faction|localized_faction_description }}</p>
                                </div>
                                <span class="shrink-0 px-2 py-0.5 rounded text-xs font-medium {{ tier.cssClass }}">
                                    {{ tier.label }}
                                </span>
                            </div>

                            {# L'axe : ce qu'on gagne ici, et ce que ca coute ailleurs. #}
                            {% set axis = axisByFaction[faction.id]|default(null) %}
                            {% if axis %}
                                <div class="flex flex-wrap items-center gap-2 text-[10px] sm:text-xs">
                                    {% if axis.neutral %}
                                        <span class="rounded bg-gray-800/60 px-1.5 py-0.5 text-gray-400">{{ 'game.factions.axis.neutral'|trans }}</span>
                                    {% else %}
                                        <span class="rounded bg-gray-800/60 px-1.5 py-0.5 text-gray-300">{{ axis.axis }}</span>
                                        {% if axis.opponent %}
                                            <span class="text-gray-500">{{ 'game.factions.axis.opposed_to'|trans({'%faction%': axis.opponent}) }}</span>
                                        {% endif %}
                                    {% endif %}
                                    {% if patron and patron.id == faction.id %}
                                        <span class="rounded bg-purple-900/60 px-1.5 py-0.5 text-purple-200">{{ 'game.factions.patronage.badge'|trans }}</span>
                                    {% endif %}
                                </div>
                            {% endif %}

                            {# Reputation bar #}
                            <div class="mt-3">
                                <div class="flex justify-between text-[10px] sm:text-xs text-gray-400 mb-1">
                                    <span>{{ 'game.factions.reputation'|trans }}</span>
                                    <span>
                                        {{ reputation }}
                                        {% if nextTier %}
                                            / {{ nextTier.threshold }}
                                        {% endif %}
                                    </span>
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-bar-fill bg-purple-500"
                                         style="width: {{ progressPercent }}%"></div>
                                </div>
                                {% if nextTier %}
                                    <div class="text-[10px] text-gray-500 mt-1">
                                        {{ 'game.factions.next_tier'|trans({'%tier%': nextTier.label}) }}
                                    </div>
                                {% else %}
                                    <div class="text-[10px] text-yellow-500 mt-1">
                                        {{ 'game.factions.max_tier'|trans }}
                                    </div>
                                {% endif %}
                            </div>

                            {# Rewards #}
                            {% if rewards is not empty %}
                                <div class="mt-3 border-t border-gray-600 pt-3">
                                    <h4 class="text-xs font-semibold text-gray-300 mb-2">{{ 'game.factions.rewards_title'|trans }}</h4>
                                    <div class="space-y-1.5">
                                        {% for reward in rewards %}
                                            {% set rewardTier = reward.requiredTier %}
                                            {% set unlocked = reputation >= rewardTier.threshold %}
                                            <div class="flex items-center gap-2 text-xs {{ unlocked ? 'text-gray-200' : 'text-gray-500' }}">
                                                <span class="shrink-0 w-4 text-center">{{ unlocked ? '&#10003;' : '&#128274;' }}</span>
                                                <span class="shrink-0 px-1.5 py-0.5 rounded text-[10px] {{ rewardTier.cssClass }} bg-gray-800/50">{{ rewardTier.label }}</span>
                                                <span class="truncate" title="{{ reward|localized_faction_reward_description }}">{{ reward|localized_faction_reward_label }}</span>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}

                            {# Porter les couleurs. Le bouton n'apparait qu'une
                               fois le palier atteint : proposer une action qui
                               sera refusee ferait chercher au joueur ce qui ne
                               va pas dans son formulaire. #}
                            {% if reputation >= patronageTier.threshold and (patron is null or patron.id != faction.id) %}
                                <form method="post" action="{{ path('app_game_factions_patron', {'id': faction.id}) }}" class="mt-3">
                                    <input type="hidden" name="_token" value="{{ csrf_token('faction_patron') }}">
                                    <button type="submit" class="rounded border border-purple-500/60 px-2 py-1 text-xs text-purple-200 hover:bg-purple-900/40">
                                        {{ 'game.factions.patronage.choose'|trans }}
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
