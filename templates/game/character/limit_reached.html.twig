{# ONB-18 — la limite de personnages, au systeme « Parchemin ».

   Un etat vide dit **quoi faire** (regle 3 du systeme). Celui-ci se contentait
   d'annoncer la limite et de renvoyer au hub : le joueur apprenait qu'il ne
   pouvait pas, jamais ce qu'il pouvait. #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'game.character.limit_reached.title_full'|trans }}{% endblock %}

{% block body %}
<div class="flex items-center justify-center min-h-[calc(100vh-4rem)] px-4 py-12">
    <div class="w-full max-w-md">
        <div class="ds-card text-center">
            <h1 class="ds-title mb-2">{{ 'game.character.limit_reached.title_short'|trans }}</h1>
            <p class="ds-hint">
                {{ 'game.character.limit_reached.body'|trans({'%count%': maxPlayers, '%plural%': maxPlayers > 1 ? 's' : ''}) }}
            </p>
            <p class="ds-hint mt-2">{{ 'game.character.limit_reached.what_to_do'|trans }}</p>

            {# Une seule action primaire : reprendre le personnage qu'on a. #}
            <a href="{{ path('app_game') }}" class="ds-btn ds-btn--primary w-full mt-6">
                {{ 'game.character.limit_reached.back'|trans }}
            </a>
            <a href="{{ path('app_character_select') }}" class="ds-btn ds-btn--quiet ds-btn--sm w-full mt-2">
                {{ 'game.character.limit_reached.switch'|trans }}
            </a>
        </div>
    </div>
</div>
{% endblock %}
