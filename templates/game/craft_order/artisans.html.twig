{% extends 'game/game.html.twig' %}

{% block title %}Artisans{% endblock %}

{% block game_content %}
<div class="game-page">
    <div class="game-card">
        <div class="game-card-header flex items-center justify-between gap-3">
            <div>
                <h2 class="text-base sm:text-lg font-semibold text-white">Artisans</h2>
                <p class="text-gray-400 text-xs mt-0.5">
                    La reputation se gagne en <strong>honorant</strong> des commandes, pas en les prenant.
                    Une commande de maitre vaut plus que dix commandes de debutant.
                </p>
            </div>
            <a href="{{ path('app_game_craft_order') }}" class="px-3 py-1.5 bg-gray-600 hover:bg-gray-500 text-white text-xs sm:text-sm rounded-lg transition-colors shrink-0">Tableau</a>
        </div>

        <div class="game-card-body">
            <div class="flex flex-wrap gap-1.5 mb-4">
                <a href="{{ path('app_game_craft_order_artisans') }}"
                   class="px-2.5 py-1 text-xs rounded-lg transition-colors {{ craft == '' ? 'bg-indigo-600 text-white' : 'bg-gray-800 text-gray-400 hover:bg-gray-700' }}">Tous</a>
                {% for c in crafts %}
                    <a href="{{ path('app_game_craft_order_artisans', {craft: c}) }}"
                       class="px-2.5 py-1 text-xs rounded-lg transition-colors {{ craft == c ? 'bg-indigo-600 text-white' : 'bg-gray-800 text-gray-400 hover:bg-gray-700' }}">{{ c }}</a>
                {% endfor %}
            </div>

            {% if mine is not empty %}
                <div class="mb-4 bg-gray-900/60 border border-gray-800 rounded-lg p-3">
                    <h3 class="text-xs font-semibold text-gray-300 mb-1.5">Votre reputation</h3>
                    <div class="flex flex-wrap gap-x-4 gap-y-1">
                        {% for r in mine %}
                            <span class="text-xs text-gray-400">
                                {{ r.craft }} : <span class="text-emerald-400 font-medium">{{ r.title }}</span>
                                ({{ r.points }} pts, {{ r.deliveries }} livraison{{ r.deliveries > 1 ? 's' : '' }})
                            </span>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {% if reputations is empty %}
                <p class="text-sm text-gray-500 py-6 text-center">
                    Aucun artisan n'a encore honore de commande{% if craft %} en {{ craft }}{% endif %}.
                </p>
            {% else %}
                <div class="space-y-1.5">
                    {% for r in reputations %}
                        <div class="bg-gray-900/60 border border-gray-800 rounded-lg px-3 py-2 flex items-center justify-between gap-4">
                            <div class="flex items-center gap-3 min-w-0">
                                <span class="text-xs text-gray-600 font-mono w-6 shrink-0">#{{ loop.index }}</span>
                                <div class="min-w-0">
                                    <p class="text-sm text-gray-100 font-medium truncate">{{ r.player.name }}</p>
                                    <p class="text-xs text-gray-500">{{ r.craft }} · {{ r.title }}</p>
                                </div>
                            </div>
                            <div class="text-right shrink-0">
                                <p class="text-sm text-emerald-400 font-mono font-semibold">{{ r.points }} pts</p>
                                <p class="text-xs text-gray-600">{{ r.deliveries }} livraison{{ r.deliveries > 1 ? 's' : '' }}</p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <p class="text-xs text-gray-600 mt-3">
                    Pour confier une commande a l'un d'eux, indiquez son nom au moment de la publier.
                </p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
