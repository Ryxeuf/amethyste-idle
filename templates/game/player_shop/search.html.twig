{% extends 'game/game.html.twig' %}

{% block title %}Rechercher sur le marche{% endblock %}

{% block game_content %}
<div class="game-page">
    <div class="game-card">
        <div class="game-card-header">
            <h2 class="text-base sm:text-lg font-semibold text-white">Rechercher sur le marche</h2>
            <p class="text-gray-400 text-xs mt-0.5">Qui vend un objet, et dans quelle zone — ou, a defaut, qui saurait le fabriquer.</p>
        </div>

        <div class="game-card-body">
            <form method="get" action="{{ path('app_game_player_shop_search') }}" class="flex flex-wrap items-end gap-2 mb-5">
                <div class="grow min-w-48">
                    <label for="q" class="block text-xs text-gray-400 mb-1">Objet recherche</label>
                    <input type="search" name="q" id="q" value="{{ query }}" placeholder="epee, potion, anneau..."
                           class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-gray-200">
                </div>
                <button type="submit" class="px-4 py-2 bg-purple-700 hover:bg-purple-600 text-ink-on text-sm rounded-lg transition-colors">Chercher</button>
            </form>

            {% if query is empty %}
                <p class="text-xs text-gray-600">Entrez le nom d'un objet.</p>
            {% else %}
                <h3 class="text-sm font-semibold text-gray-200 mb-2">En vente</h3>
                {% if onSale is empty %}
                    <p class="text-xs text-gray-600 mb-5">Personne ne vend cela pour l'instant.</p>
                {% else %}
                    <ul class="space-y-1.5 mb-5">
                        {% for listing in onSale %}
                            <li class="flex items-center justify-between gap-2 rounded-md bg-gray-800/40 border border-gray-700/60 px-3 py-2">
                                <span class="text-sm text-gray-100">
                                    {{ listing.playerItem.genericItem.name }}
                                    <span class="text-xs text-gray-500">×{{ listing.quantity }}</span>
                                    <span class="block text-[11px] text-gray-500">
                                        {{ listing.shop.name }} — {{ listing.shop.zone.localizedName(app.request.locale) }}
                                    </span>
                                </span>
                                <span class="flex items-center gap-2">
                                    <span class="text-xs text-amber-200 font-mono">{{ listing.unitPrice }} Gils / u.</span>
                                    <a href="{{ path('app_game_player_shop_visit', {id: listing.shop.id}) }}"
                                       class="px-2.5 py-1 text-xs rounded-lg bg-gray-800 border border-gray-700 text-gray-300 hover:text-white">Voir</a>
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {# La seconde moitie de la reponse : un resultat vide qui n'ouvre
                   sur rien fait cesser la recherche. #}
                <h3 class="text-sm font-semibold text-gray-200 mb-2">Artisans capables</h3>
                {% if crafters is empty %}
                    <p class="text-xs text-gray-600">Aucun artisan connu ne sait fabriquer cela.</p>
                {% else %}
                    <ul class="space-y-1.5">
                        {% for match in crafters %}
                            <li class="flex items-center justify-between gap-2 rounded-md bg-gray-800/40 border border-gray-700/60 px-3 py-2">
                                <span class="text-sm text-gray-100">
                                    {{ match.shop.owner.name }}
                                    <span class="text-xs text-gray-500">— {{ match.recipe.name }}</span>
                                    <span class="block text-[11px] text-gray-500">
                                        {{ match.shop.name }} · {{ match.shop.zone.localizedName(app.request.locale) }}
                                        · {{ match.recipe.craft|capitalize }} niveau {{ match.level }}
                                    </span>
                                </span>
                                <a href="{{ path('app_game_craft_order_new', {crafter: match.shop.owner.name}) }}"
                                   class="px-2.5 py-1 text-xs rounded-lg bg-purple-900/40 border border-purple-600 text-purple-100 hover:bg-purple-800/50">Commander</a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
