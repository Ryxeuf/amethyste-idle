{# ===== MACRO: En-tete de section repliable ===== #}
{% macro section_header(title, count, accent, icon) %}
<button type="button" class="inv-section-header" data-action="collapse#toggle" data-collapse-target="trigger">
    <span class="inv-section-title inv-section-title--{{ accent }}">
        {{ icon }}
        {{ title }}
    </span>
    {% if count > 0 %}
        <span class="inv-section-count">{{ count }}</span>
    {% endif %}
    {{ _self.collapse_chevron() }}
</button>
{% endmacro %}

{% macro collapse_chevron() %}
<svg xmlns="http://www.w3.org/2000/svg" class="collapse-icon" data-collapse-target="icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
{% endmacro %}

{% macro icon_gear() %}
<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
{% endmacro %}

{% macro icon_bag() %}
<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
{% endmacro %}

{# ===== MACRO: Ligne d'outil disponible ===== #}
{% macro tool_row(item, toolState) %}
{% set gi = item.genericItem %}
{% set canEquip = toolState == 'ok' %}
<div class="equip-available-item group equip-rarity-common"
     data-inventory-target="item"
     data-item-name="{{ gi.name }}"
     data-item-desc="{{ gi.description }}"
     data-item-kind="tool"
     data-item-tool-type="{{ gi.toolType }}"
     data-item-tier="{{ gi.toolTier }}"
     data-item-durability="{{ item.currentDurability ?? gi.durability }}"
     data-item-durability-max="{{ gi.durability }}"
     data-item-value="{{ gi.price ?? 0 }}"
     {% if not canEquip %}data-item-lock="{{ toolState }}"{% endif %}>
    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg flex items-center justify-center shrink-0 bg-amber-900/50 text-amber-400">
        {{ _self.tool_icon(gi.toolType) }}
    </div>
    <div class="flex-1 min-w-0">
        <div class="text-xs sm:text-sm font-medium truncate text-amber-200">{{ gi.name }}</div>
        <div class="flex items-center gap-1.5 mt-0.5">
            <span class="text-[10px] text-gray-500">{{ _self.tool_slot_label(gi.toolType) }}</span>
            {% if gi.durability is not null %}
                <span class="text-[10px] text-amber-400/80" title="{{ 'game.inventory.tools.durability'|trans }}">{{ item.currentDurability ?? gi.durability }}/{{ gi.durability }}</span>
            {% endif %}
            {% if gi.toolTier is not null %}
                <span class="text-[10px] text-gray-500" title="{{ 'game.inventory.tools.tier'|trans({'%tier%': gi.toolTier}) }}">T{{ gi.toolTier }}</span>
            {% endif %}
        </div>
        {% if not canEquip %}
            {# Le motif du verrou doit se lire sans survol : sur mobile, un
               `title` n'existe pas. #}
            <div class="text-[10px] text-amber-500/70 mt-0.5 truncate">{{ ('game.inventory.tools.' ~ toolState)|trans }}</div>
        {% endif %}
    </div>
    {% if canEquip %}
        <form method="post" action="{{ path('app_game_inventory_equipment_equip', {id: item.id}) }}" data-turbo-frame="inventory-content" class="shrink-0">
            <button type="submit" class="w-8 h-8 rounded-lg bg-amber-600/80 hover:bg-amber-500 text-white flex items-center justify-center transition-all" title="{{ 'game.inventory.actions.equip'|trans }}">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </button>
        </form>
    {% else %}
        <div class="w-8 h-8 rounded-lg bg-gray-700/40 text-gray-600 flex items-center justify-center shrink-0 cursor-not-allowed"
             title="{{ ('game.inventory.tools.' ~ toolState)|trans }}">
            {% if toolState == 'locked_skill' %}
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
            {% else %}
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            {% endif %}
        </div>
    {% endif %}
</div>
{% endmacro %}

{# ===== MACRO: Ligne d'equipement disponible ===== #}
{% macro gear_row(item, equipped, canEquip) %}
{% set gi = item.genericItem %}
{% set eqSlot = gi.gearLocation %}
{% set eqItem = equipped[eqSlot] is defined ? equipped[eqSlot] : null %}
<div class="equip-available-item group {{ _self.rarity_border_class(gi.rarity) }}"
     data-inventory-target="item"
     data-item-name="{{ gi.name }}"
     data-item-desc="{{ gi.description }}"
     data-item-rarity="{{ gi.rarity }}"
     data-item-protection="{{ gi.protection }}"
     data-item-level="{{ gi.level }}"
     data-item-element="{{ gi.element.value }}"
     data-item-slot="{{ gi.gearLocation }}"
     data-item-materia-total="{{ gi.materiaSlots }}"
     data-item-materia-filled="0"
     data-item-kind="gear"
     data-item-value="{{ gi.price ?? 0 }}"
     {% if not canEquip %}data-item-lock="locked_skill_gear"{% endif %}
     {% if eqItem is not null %}
     data-item-eq-name="{{ eqItem.genericItem.name }}"
     data-item-eq-protection="{{ eqItem.genericItem.protection }}"
     data-item-eq-materia-total="{{ eqItem.genericItem.materiaSlots }}"
     data-item-eq-element="{{ eqItem.genericItem.element.value }}"
     data-item-eq-rarity="{{ eqItem.genericItem.rarity }}"
     {% endif %}>
    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg flex items-center justify-center shrink-0 {{ _self.rarity_bg_class(gi.rarity) }}">
        {{ _self.slot_icon(gi.gearLocation) }}
    </div>
    <div class="flex-1 min-w-0">
        <div class="text-xs sm:text-sm font-medium truncate {{ _self.rarity_text_class(gi.rarity) }}">{{ gi.name }}</div>
        <div class="flex items-center gap-1.5 mt-0.5">
            <span class="text-[10px] text-gray-500">{{ _self.slot_name(gi.gearLocation) }}</span>
            {% if gi.protection > 0 %}
                <span class="text-[10px] text-blue-400 font-medium">+{{ gi.protection }} DEF</span>
            {% endif %}
            {% if gi.materiaSlots > 0 %}
                <span class="text-[10px] text-purple-400/80 flex items-center gap-0.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-2 w-2" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10" opacity=".3"/><circle cx="12" cy="12" r="5"/></svg>
                    {{ 'game.inventory.materia_slots_short'|trans({'%count%': gi.materiaSlots}) }}
                </span>
            {% endif %}
            {% if gi.equipmentSet is not null %}
                <span class="text-[10px] text-yellow-500/70">{{ gi.equipmentSet|localized_equipment_set_name }}</span>
            {% endif %}
        </div>
    </div>
    {% if canEquip %}
        <form method="post" action="{{ path('app_game_inventory_equipment_equip', {id: item.id}) }}" data-turbo-frame="inventory-content" class="shrink-0">
            <button type="submit" class="w-8 h-8 rounded-lg bg-purple-600/80 hover:bg-purple-500 text-white flex items-center justify-center transition-all" title="{{ 'game.inventory.actions.equip'|trans }}">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </button>
        </form>
    {% else %}
        <div class="w-8 h-8 rounded-lg bg-gray-700/50 text-gray-500 flex items-center justify-center cursor-not-allowed" title="{{ 'game.inventory.locked_skill_gear'|trans }}">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        </div>
    {% endif %}
</div>
{% endmacro %}

{% endblock %}
