{% extends 'game/game.html.twig' %}

{% block title %}{{ card.title }} - {{ "game.skills.catalog.title"|trans }}{% endblock %}

{#
    Un arbre **ferme**, vu depuis le catalogue (ONB-09).

    Cet ecran remplace le detail complet que `DomainInfoController` servait a
    tout le monde. Il dit ce que le catalogue a le droit de dire, et rien de
    plus : le controleur retourne ici **avant** d'avoir lu la moindre
    competence, pour qu'aucune variable de nœud n'existe dans ce contexte.
#}
{% block game_content %}
<div class="game-page">

    <div class="mb-4">
        <h1 class="ds-title">{{ card.title }}</h1>
        <p class="ds-hint mt-0.5 flex items-center gap-2">
            {% if card.element %}
                <span class="ds-elem ds-elem-{{ card.element }} w-2 h-2"></span>
                <span>{{ ("game.skills.catalog.element." ~ card.element)|trans }}</span>
                <span aria-hidden="true">·</span>
            {% endif %}
            <span>{{ ("game.skills.catalog.family." ~ card.family)|trans }}</span>
        </p>
    </div>

    <div class="ds-panel p-4 mb-4">
        <p class="ds-body mb-3">{{ card.teaches }}</p>

        <div class="ds-stat">
            <span class="ds-stat__label">{{ "game.skills.catalog.equips"|trans }}</span>
            <span class="ds-body">{{ card.equips }}</span>
        </div>

        <div class="ds-stat">
            <span class="ds-stat__label">{{ "game.skills.catalog.parchment"|trans }}</span>
            <span class="ds-body">
                {% if card.parchmentName %}
                    {{ card.parchmentName }}
                    {% if card.parchmentPrice is not null %}
                        — <span class="ds-num ds-num--sm">{{ card.parchmentPrice }}</span>
                    {% endif %}
                {% else %}
                    {{ "game.skills.catalog.parchment_unknown"|trans }}
                {% endif %}
            </span>
        </div>
    </div>

    <div class="ds-empty">
        <p class="ds-empty__title">{{ "game.skills.catalog.closed_title"|trans }}</p>
        <p class="ds-empty__hint">{{ "game.skills.catalog.closed_hint"|trans }}</p>
    </div>

    <div class="mt-4 flex gap-2">
        <a href="{{ path('app_game_skills_catalog') }}" class="ds-btn ds-btn--secondary ds-btn--sm">
            {{ "game.skills.catalog.back_to_catalog"|trans }}
        </a>
        <a href="{{ path('app_game_skills') }}" class="ds-btn ds-btn--quiet ds-btn--sm">
            {{ "game.skills.catalog.back_to_trees"|trans }}
        </a>
    </div>

</div>
{% endblock %}
