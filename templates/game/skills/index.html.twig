{% extends 'game/game.html.twig' %}

{% block title %}{{ "title.skills"|trans }}{% endblock %}

{% block game_content %}

{# ─── Default active domain : premier avec une compétence disponible, sinon premier ─── #}
{% set activeDomainId = 0 %}
{% for domain in domains %}
    {% if activeDomainId == 0 %}
        {% for skill in domain.skills %}
            {% if skill.canBeAcquired and not skill.acquired and activeDomainId == 0 %}
                {% set activeDomainId = domain.id %}
            {% endif %}
        {% endfor %}
    {% endif %}
{% endfor %}
{% if activeDomainId == 0 and domains|length > 0 %}
    {% set activeDomainId = domains[0].id %}
{% endif %}

{# ─── Configuration des éléments ─── #}
{% set elementConfig = {
    'fire':  {label: 'Feu',     dot: 'ds-elem ds-elem-fire',  text: 'ds-label'},
    'water': {label: 'Eau',     dot: 'ds-elem ds-elem-water', text: 'ds-label'},
    'air':   {label: 'Air',     dot: 'ds-elem ds-elem-air',   text: 'ds-label'},
    'earth': {label: 'Terre',   dot: 'ds-elem ds-elem-earth', text: 'ds-label'},
    'metal': {label: 'Métal',   dot: 'ds-elem ds-elem-metal', text: 'ds-label'},
    'beast': {label: 'Bête',    dot: 'ds-elem ds-elem-beast', text: 'ds-label'},
    'light': {label: 'Lumière', dot: 'ds-elem ds-elem-light', text: 'ds-label'},
    'dark':  {label: 'Ombre',   dot: 'ds-elem ds-elem-dark',  text: 'ds-label'},
} %}
{% set elementOrder = ['fire', 'water', 'air', 'earth', 'metal', 'beast', 'light', 'dark'] %}

<div class="game-page"
     data-controller="skills"
     data-skills-active-domain-value="{{ activeDomainId }}">

    {# ═══════════════════════════════════════════
       MODAL RESPEC
    ═══════════════════════════════════════════ #}
    {% if skillCount > 0 %}
        <div data-skills-target="respecModal"
             class="hidden fixed inset-0 z-50 flex items-center justify-center bg-ink/45"
             data-action="click->skills#closeRespecOnBackdrop">
            <div class="ds-panel p-6 max-w-sm mx-4">
                <h3 class="ds-title mb-3">{{ "game.skills.respec.title"|trans }}</h3>
                <p class="ds-body mb-3">
                    {{ "game.skills.respec.description"|trans }}
                </p>
                <div class="ds-card p-3 mb-4">
                    <div class="ds-stat">
                        <span class="ds-stat__label">{{ "game.skills.respec.count_label"|trans }}</span>
                        <span class="ds-num">{{ skillCount }}</span>
                    </div>
                    <div class="ds-stat">
                        <span class="ds-stat__label">{{ "game.skills.respec.cost_label"|trans }}</span>
                        <span class="ds-num ds-num--loss">{{ "game.skills.respec.gils_amount"|trans({'%count%': respecCost}) }}</span>
                    </div>
                    <div class="ds-stat">
                        <span class="ds-stat__label">{{ "game.skills.respec.your_gils_label"|trans }}</span>
                        <span class="ds-num {{ canRespec ? 'ds-num--gain' : 'ds-num--loss' }}">{{ "game.skills.respec.gils_amount"|trans({'%count%': playerGils}) }}</span>
                    </div>
                </div>
                <div class="flex gap-3">
                    <button type="button"
                            data-action="click->skills#closeRespec"
                            class="ds-btn ds-btn--secondary flex-1">
                        {{ "common.cancel"|trans }}
                    </button>
                    {% if canRespec %}
                        <form action="{{ path('app_game_skill_respec') }}" method="post" class="flex-1">
                            <input type="hidden" name="_token" value="{{ csrf_token('respec') }}">
                            <button type="submit"
                                    class="ds-btn ds-btn--primary w-full">
                                {{ "common.confirm"|trans }}
                            </button>
                        </form>
                    {% else %}
                        <button type="button" disabled
                                class="ds-btn ds-btn--disabled flex-1">
                            {{ "game.skills.respec.insufficient_funds"|trans }}
                        </button>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endif %}

    {# ═══════════════════════════════════════════
       HEADER : Titre + barre de points + Respec
    ═══════════════════════════════════════════ #}
    <div class="mb-4">
        <div class="flex items-start justify-between mb-2">
            <div>
                <h1 class="ds-title">{{ "title.skills"|trans }}</h1>
                <p class="ds-hint mt-0.5">{{ "game.skills.description"|trans }}</p>
                <a href="{{ path('app_game_skills_catalog') }}" class="ds-btn ds-btn--quiet ds-btn--sm mt-2 inline-flex">
                    {{ "game.skills.catalog.title"|trans }}
                </a>
            </div>
            {% if skillCount > 0 %}
                <button type="button"
                        data-action="click->skills#openRespec"
                        class="ds-btn ds-btn--sm {{ canRespec ? 'ds-btn--secondary' : 'ds-btn--disabled' }} shrink-0 ml-4">
                    {{ "game.skills.respec.trigger_button"|trans }}
                </button>
            {% endif %}
        </div>
        {# ARC-10 — il n'y a plus de plafond global, donc plus de jauge : une
           jauge sans maximum ne mesure rien. Le total investi reste affiche,
           parce que c'est une information (ce que le personnage a appris),
           jamais une borne. #}
        <div class="flex items-center gap-3">
            <span class="ds-label shrink-0">{{ 'game.skills.points_invested'|trans }}</span>
            <span class="ds-num shrink-0">{{ totalUsedPoints }}</span>
        </div>
    </div>

    {# ═══════════════════════════════════════════
       RÉSUMÉ DU BUILD ACTIF
    ═══════════════════════════════════════════ #}
    <div class="ds-banner mb-4">
        <div class="flex items-center gap-3 flex-wrap">
            <span class="ds-label shrink-0">Build actif</span>
            {% if buildStats.count == 0 %}
                <span class="ds-hint italic">Aucune compétence apprise.</span>
            {% else %}
                <span class="ds-num ds-num--sm">{{ buildStats.count }} compétence{{ buildStats.count > 1 ? 's' : '' }}</span>
                <div class="flex items-center gap-1.5 flex-wrap">
                    {% if buildStats.damage > 0 %}
                        <span class="stat-badge stat-badge-damage">⚔ +{{ buildStats.damage }} dég.</span>
                    {% endif %}
                    {% if buildStats.heal > 0 %}
                        <span class="stat-badge stat-badge-heal">✦ +{{ buildStats.heal }} soin</span>
                    {% endif %}
                    {% if buildStats.hit > 0 %}
                        <span class="stat-badge stat-badge-hit">🎯 +{{ buildStats.hit }} préc.</span>
                    {% endif %}
                    {% if buildStats.critical > 0 %}
                        <span class="stat-badge stat-badge-critical">💥 +{{ buildStats.critical }} crit.</span>
                    {% endif %}
                    {% if buildStats.life > 0 %}
                        <span class="stat-badge stat-badge-life">❤ +{{ buildStats.life }} vie</span>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>

    {# ═══════════════════════════════════════════
       PRESETS (collapsible)
    ═══════════════════════════════════════════ #}
    <div class="mb-4 game-card overflow-hidden">
        <button type="button"
                data-action="click->skills#togglePresets"
                class="game-card-header w-full flex items-center justify-between">
            <span class="ds-name ds-name--sm">Presets de build</span>
            <span class="ds-num ds-num--sm">{{ presets|length }}/{{ maxPresets }} ▾</span>
        </button>
        <div data-skills-target="presetsPanel" class="hidden p-3 sm:p-4">
            {% if canSavePreset %}
                <form action="{{ path('app_game_skill_preset_save') }}" method="post" class="flex gap-2 mb-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('preset_save') }}">
                    <input type="text" name="preset_name" placeholder="Nom du preset..." maxlength="50" required
                           class="flex-1 bg-paper border border-line rounded-card px-3 py-1.5 text-sm text-ink focus:border-brand focus:outline-hidden">
                    <button type="submit"
                            class="ds-btn ds-btn--secondary ds-btn--sm shrink-0">
                        Sauvegarder
                    </button>
                </form>
            {% elseif skillCount > 0 %}
                <p class="ds-hint mb-3">Limite de {{ maxPresets }} presets atteinte.</p>
            {% else %}
                <p class="ds-hint mb-3">Apprenez des compétences pour sauvegarder un preset.</p>
            {% endif %}
            {% if presets|length > 0 %}
                <div class="space-y-2">
                    {% for preset in presets %}
                        <div class="ds-row">
                            <div class="ds-row__body">
                                <span class="ds-row__name ds-name--sm truncate block">{{ preset.name }}</span>
                                <span class="ds-num ds-num--sm text-left">{{ preset.skillSlugs|length }} compétence{{ preset.skillSlugs|length > 1 ? 's' : '' }}</span>
                            </div>
                            <div class="flex gap-2 shrink-0 ml-3">
                                <form action="{{ path('app_game_skill_preset_load', {id: preset.id}) }}" method="post">
                                    <input type="hidden" name="_token" value="{{ csrf_token('preset_load_' ~ preset.id) }}">
                                    <button type="submit"
                                            class="ds-btn ds-btn--secondary ds-btn--sm"
                                            onclick="return confirm('Charger ce preset ? Vos compétences actuelles seront redistribuées (coût en gils).')">
                                        Charger
                                    </button>
                                </form>
                                <form action="{{ path('app_game_skill_preset_delete', {id: preset.id}) }}" method="post">
                                    <input type="hidden" name="_token" value="{{ csrf_token('preset_delete_' ~ preset.id) }}">
                                    <button type="submit"
                                            class="ds-btn ds-btn--quiet ds-btn--sm text-loss"
                                            onclick="return confirm('Supprimer ce preset ?')">
                                        Supprimer
                                    </button>
                                </form>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p class="ds-hint text-center py-1">Aucun preset sauvegardé.</p>
            {% endif %}
        </div>
    </div>

    {# ═══════════════════════════════════════════
       MAIN : SIDEBAR + DOMAIN PANELS
    ═══════════════════════════════════════════ #}
    {% if domains|length == 0 %}
        {# ONB-09 — l'etat vide dit quoi faire, et il ne dit plus une chose fausse :
           un arbre ne s'ouvre pas en combattant, il s'ouvre en lisant son parchemin. #}
        <div class="ds-empty">
            <p class="ds-empty__title">{{ "game.skills.catalog.none_open_title"|trans }}</p>
            <p class="ds-empty__hint">{{ "game.skills.catalog.none_open_hint"|trans }}</p>
            <a href="{{ path('app_game_skills_catalog') }}" class="ds-btn ds-btn--primary ds-btn--sm mt-3 inline-flex">
                {{ "game.skills.catalog.title"|trans }}
            </a>
        </div>
    {% else %}
        <div class="flex flex-col lg:flex-row gap-4 lg:gap-5 items-start">

            {# ────────── SIDEBAR ────────── #}
            <aside class="skills-sidebar">

                {# Mobile : chips horizontales scrollables #}
                <div class="lg:hidden overflow-x-auto pb-2 -mx-0.5 px-0.5 mb-4">
                    <div class="flex gap-2 w-max">
                        {% for domain in domains %}
                            {% set availCount = domain.skills|filter(s => s.canBeAcquired and not s.acquired)|length %}
                            <button type="button"
                                    data-skills-target="domainBtn"
                                    data-action="click->skills#selectDomain"
                                    data-domain-id="{{ domain.id }}"
                                    aria-selected="{{ domain.id == activeDomainId ? 'true' : 'false' }}"
                                    class="skills-domain-btn skills-domain-chip ds-pill shrink-0">
                                {% if domain.element and elementConfig[domain.element] is defined %}
                                    <span class="{{ elementConfig[domain.element].dot }} w-2 h-2"></span>
                                {% endif %}
                                <span>{{ domain|localized_domain_title }}</span>
                                {% if availCount > 0 %}
                                    <span class="ds-seal ds-seal-epic">{{ availCount }}</span>
                                {% endif %}
                            </button>
                        {% endfor %}
                    </div>
                </div>

                {# Desktop : sidebar groupée par élément #}
                <div class="hidden lg:block w-52 shrink-0 sticky top-4 space-y-3">
                    {% for element in elementOrder %}
                        {% set groupDomains = domains|filter(d => d.element == element) %}
                        {% if groupDomains|length > 0 %}
                            {% set cfg = elementConfig[element] %}
                            <div>
                                <div class="flex items-center gap-1.5 px-2 pb-1 mb-0.5">
                                    <span class="{{ cfg.dot }} w-2 h-2"></span>
                                    <span class="{{ cfg.text }}">{{ cfg.label }}</span>
                                </div>
                                {% for domain in groupDomains %}
                                    {% set availCount   = domain.skills|filter(s => s.canBeAcquired and not s.acquired)|length %}
                                    {% set acquiredCount = domain.skills|filter(s => s.acquired)|length %}
                                    <button type="button"
                                            data-skills-target="domainBtn"
                                            data-action="click->skills#selectDomain"
                                            data-domain-id="{{ domain.id }}"
                                            aria-selected="{{ domain.id == activeDomainId ? 'true' : 'false' }}"
                                            class="skills-domain-btn w-full text-left mb-0.5">
                                        <div class="flex items-center justify-between gap-1">
                                            <span class="ds-name ds-name--sm truncate">{{ domain|localized_domain_title }}</span>
                                            {% if availCount > 0 %}
                                                <span class="ds-seal ds-seal-epic shrink-0">{{ availCount }}</span>
                                            {% elseif acquiredCount > 0 %}
                                                <span class="ds-seal ds-seal--gain shrink-0">✓{{ acquiredCount }}</span>
                                            {% endif %}
                                        </div>
                                        {% if domain.totalExperience is defined and domain.totalExperience > 0 %}
                                            <div class="ds-meter mt-1" style="height: 4px">
                                                {% set xpPct = domain.totalExperience > 0 ? (domain.availableExperience / domain.totalExperience * 100) : 0 %}
                                                <div class="ds-meter__fill" style="width: {{ xpPct > 100 ? 100 : xpPct }}%"></div>
                                            </div>
                                            <div class="ds-num ds-num--sm text-left mt-0.5">{{ domain.availableExperience }} XP dispo</div>
                                        {% endif %}
                                    </button>
                                {% endfor %}
                            </div>
                        {% endif %}
                    {% endfor %}

                    {# Domaines hors éléments classifiés #}
                    {% set ungrouped = domains|filter(d => d.element is null or d.element not in elementOrder) %}
                    {% if ungrouped|length > 0 %}
                        <div>
                            <div class="flex items-center gap-1.5 px-2 pb-1 mb-0.5">
                                <span class="ds-label">{{ "game.skills.sidebar.others_group"|trans }}</span>
                            </div>
                            {% for domain in ungrouped %}
                                {% set availCount = domain.skills|filter(s => s.canBeAcquired and not s.acquired)|length %}
                                <button type="button"
                                        data-skills-target="domainBtn"
                                        data-action="click->skills#selectDomain"
                                        data-domain-id="{{ domain.id }}"
                                        aria-selected="{{ domain.id == activeDomainId ? 'true' : 'false' }}"
                                        class="skills-domain-btn w-full text-left mb-0.5">
                                    <div class="flex items-center justify-between gap-1">
                                        <span class="ds-name ds-name--sm truncate">{{ domain|localized_domain_title }}</span>
                                        {% if availCount > 0 %}
                                            <span class="ds-seal ds-seal-epic shrink-0">{{ availCount }}</span>
                                        {% endif %}
                                    </div>
                                </button>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>

            </aside>{# end sidebar #}

            {# ────────── DOMAIN PANELS ────────── #}
            <div class="flex-1 min-w-0">
                {% for domain in domains %}
                    <div data-skills-target="domainPanel"
                         data-domain-id="{{ domain.id }}"
                         class="{{ domain.id != activeDomainId ? 'hidden' : '' }}">

                        {# En-tête du domaine #}
                        <div class="ds-panel mb-4 flex items-center justify-between flex-wrap gap-2">
                            <div class="flex items-center gap-2.5">
                                {% if domain.element and elementConfig[domain.element] is defined %}
                                    <span class="{{ elementConfig[domain.element].dot }}"></span>
                                {% endif %}
                                <h2 class="ds-title">{{ domain|localized_domain_title }}</h2>
                                {% if domain.element and elementConfig[domain.element] is defined %}
                                    <span class="ds-seal ds-seal-common">
                                        {{ elementConfig[domain.element].label }}
                                    </span>
                                {% endif %}
                                {# DOM-02 : ce que le build exprime. Le savoir reste acquis —
                                   seule son expression depend de l'equipement. #}
                                {% if domain.activeInBuild is not null %}
                                    <span class="ds-seal {{ domain.activeInBuild ? 'ds-seal-rare' : 'ds-seal-common' }}"
                                          title="{{ domain.activeInBuild ? 'Ce que vous portez exprime cet arbre.' : domain.activationHint }}">
                                        {{ domain.activeInBuild ? 'Exprimé' : 'Non exprimé' }}
                                    </span>
                                {% endif %}
                            </div>
                            <div class="flex items-center gap-3 flex-wrap">
                                {% if domain.totalExperience is defined and domain.totalExperience > 0 %}
                                    <span class="ds-num">
                                        XP dispo : {{ domain.availableExperience }}
                                    </span>
                                    <span class="ds-num ds-num--muted hidden sm:inline">
                                        Total : {{ domain.totalExperience }}
                                    </span>
                                {% endif %}
                                {% if domain.damage is defined and domain.damage > 0 %}
                                    <span class="ds-num ds-num--sm">⚔ +{{ domain.damage }}</span>
                                {% endif %}
                                {% if domain.hit is defined and domain.hit > 0 %}
                                    <span class="ds-num ds-num--sm">🎯 +{{ domain.hit }}</span>
                                {% endif %}
                                {% if domain.critical is defined and domain.critical > 0 %}
                                    <span class="ds-num ds-num--sm">💥 +{{ domain.critical }}</span>
                                {% endif %}
                                <a href="{{ path('app_game_domain_info', {id: domain.id}) }}"
                                   class="ds-btn ds-btn--secondary ds-btn--sm">
                                    Details
                                </a>
                            </div>
                        </div>

                        {# DOM-02 : dire quoi faire, jamais seulement constater. La borne est
                           materielle et se leve en changeant d'equipement — l'ecrire evite
                           qu'un « non exprime » se lise comme une sanction. #}
                        {% if domain.activeInBuild is same as(false) %}
                            <div class="ds-card p-3 mb-4">
                                <p class="ds-hint">
                                    Les passifs de cet arbre restent acquis, mais rien de ce que vous portez ne les exprime.
                                    {{ domain.activationHint }}
                                </p>
                            </div>
                        {% endif %}

                        {% set skillsAvailable = domain.skills|filter(s => s.canBeAcquired and not s.acquired) %}
                        {% set skillsAcquired  = domain.skills|filter(s => s.acquired) %}

                        {# ── Section Disponibles ── #}
                        <div class="mb-5">
                            <h3 class="ds-label mb-2 px-0.5">
                                Disponibles
                                <span class="ds-num ds-num--sm ml-1">{{ skillsAvailable|length }}</span>
                            </h3>
                            {% if skillsAvailable|length == 0 %}
                                <div class="ds-empty"><p class="ds-empty__hint">Aucune compétence disponible pour l'instant.</p></div>
                            {% else %}
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                    {% for skill in skillsAvailable %}
                                        <div class="skill-node skill-node--available ds-card ds-edge-epic p-3">
                                            <div class="flex items-start justify-between gap-2">
                                                <div class="min-w-0 flex-1">
                                                    <h4 class="ds-name ds-name--sm">{{ skill.title }}</h4>
                                                    <p class="ds-hint mt-0.5">{{ skill.description }}</p>
                                                    <div class="flex flex-wrap gap-1 mt-2">
                                                        <span class="ds-num ds-num--sm">{{ skill.requiredPoints }} pts XP</span>
                                                        {% for req in skill.requirements %}
                                                            <span class="ds-seal {{ req.acquired ? 'ds-seal--gain' : 'ds-seal--loss' }}">
                                                                {{ req.title }} {{ req.acquired ? '✓' : '✗' }}
                                                            </span>
                                                        {% endfor %}
                                                        {% if skill.damage > 0 %}<span class="stat-badge stat-badge-damage">+{{ skill.damage }} dég.</span>{% endif %}
                                                        {% if skill.heal > 0 %}<span class="stat-badge stat-badge-heal">+{{ skill.heal }} soin</span>{% endif %}
                                                        {% if skill.hit > 0 %}<span class="stat-badge stat-badge-hit">+{{ skill.hit }} préc.</span>{% endif %}
                                                        {% if skill.critical > 0 %}<span class="stat-badge stat-badge-critical">+{{ skill.critical }} crit.</span>{% endif %}
                                                        {% if skill.life > 0 %}<span class="stat-badge stat-badge-life">+{{ skill.life }} vie</span>{% endif %}
                                                        {# ARC-12b — ce qu'un nœud rapporte, et ce qu'il faut porter pour l'obtenir. #}
                                                        {% for readout in skill.leverReadouts|default([]) %}
                                                            <span class="ds-seal {{ readout.conditional ? 'ds-seal--gain' : '' }}">
                                                                {{ readout.leverLabel }} {{ readout.formattedEffect }}{% if readout.conditional %} — {{ readout.requirement }}{% endif %}{% if readout.pact %} · {{ readout.pactCost }}{% endif %}
                                                            </span>
                                                        {% endfor %}
                                                    </div>
                                                </div>
                                                <form action="{{ path('app_game_skill_acquire') }}" method="post" class="shrink-0">
                                                    <input type="hidden" name="skill_id" value="{{ skill.id }}">
                                                    <input type="hidden" name="domain_id" value="{{ domain.id }}">
                                                    <button type="submit"
                                                            class="ds-btn ds-btn--secondary ds-btn--sm touch-target whitespace-nowrap">
                                                        {{ "game.skills.learn"|trans }}
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        {# ── Section Acquises ── #}
                        {% if skillsAcquired|length > 0 %}
                            <div class="mb-5">
                                <h3 class="ds-label mb-2 px-0.5">
                                    Acquises
                                    <span class="ds-num ds-num--sm ml-1">{{ skillsAcquired|length }}</span>
                                </h3>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                    {% for skill in skillsAcquired %}
                                        <div class="skill-node skill-node--acquired ds-card ds-edge-uncommon p-3">
                                            <div class="flex items-start justify-between gap-2">
                                                <div class="min-w-0 flex-1">
                                                    <div class="flex items-center gap-1.5">
                                                        <span class="text-gain text-xs leading-none">✓</span>
                                                        <h4 class="ds-name ds-name--sm">{{ skill.title }}</h4>
                                                    </div>
                                                    <p class="ds-hint mt-0.5">{{ skill.description }}</p>
                                                    {% set hasStats = skill.damage > 0 or skill.heal > 0 or skill.hit > 0 or skill.critical > 0 or skill.life > 0 %}
                                                    {% if hasStats %}
                                                        <div class="flex flex-wrap gap-1 mt-1.5">
                                                            {% if skill.damage > 0 %}<span class="stat-badge stat-badge-damage">+{{ skill.damage }} dég.</span>{% endif %}
                                                            {% if skill.heal > 0 %}<span class="stat-badge stat-badge-heal">+{{ skill.heal }} soin</span>{% endif %}
                                                            {% if skill.hit > 0 %}<span class="stat-badge stat-badge-hit">+{{ skill.hit }} préc.</span>{% endif %}
                                                            {% if skill.critical > 0 %}<span class="stat-badge stat-badge-critical">+{{ skill.critical }} crit.</span>{% endif %}
                                                            {% if skill.life > 0 %}<span class="stat-badge stat-badge-life">+{{ skill.life }} vie</span>{% endif %}
                                                        </div>
                                                    {% endif %}
                                                </div>
                                                <span class="ds-seal ds-seal--gain shrink-0">
                                                    {{ "game.skills.learned"|trans }}
                                                </span>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}

                    </div>{# end domain panel #}
                {% endfor %}
            </div>{# end panels #}

        </div>{# end flex layout #}
    {% endif %}

</div>{# end game-page #}
{% endblock %}

{#
   Les en-tetes de domaine ne portent plus de degrade par slug : le systeme de
   design reserve la couleur pleine a l'action primaire, et l'appartenance
