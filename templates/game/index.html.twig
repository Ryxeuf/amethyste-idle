{% extends 'game/game.html.twig' %}

{% block title %}{{ 'game.title'|trans }}{% endblock %}

{% block game_content %}
{#
   Le hub — premier ecran apres connexion.

   Il repond a deux questions, et refuse le reste :
   1. « je fais quoi maintenant ? » -> la reprise, une seule action primaire,
      dictee par l'etat du personnage (mort, combat, voyage, expedition, pret) ;
   2. « qu'est-ce qui m'attend ? » -> les attentes actionnables, puis le recap
      de ce qui vient d'etre fait.

   Ce qu'on n'y met pas, et pourquoi : l'equipement porte (c'est l'inventaire),
   le detail d'une quete (c'est le journal de quetes), et toute statistique deja
   lisible ailleurs sur le meme ecran. L'ancienne « barre de statut monde »
   repetait les Gils et la zone pour la troisieme fois.
#}
{% set locale = app.request.locale %}
{% set resumeZone = resume.zone ? resume.zone.localizedName(locale) : '' %}
{% set resumeMinutes = resume.remainingSeconds is not null ? (resume.remainingSeconds / 60)|round(0, 'ceil') : 0 %}

<div class="game-page space-y-4 sm:space-y-6">

    {# ===== 1. LA REPRISE — l'unique action primaire de l'ecran ===== #}
    <div class="game-card">
        <div class="game-card-body">
            <div class="flex flex-wrap items-start justify-between gap-4">
                <div class="min-w-0">
                    <p class="ds-eyebrow">{{ 'game.home.resume.eyebrow'|trans }}</p>
                    <h1 class="ds-title truncate">{{ player.name }}</h1>
                    <p class="ds-hint mt-1">
                        {{ ('game.home.resume.state.' ~ resume.state)|trans({'%zone%': resumeZone, '%minutes%': resumeMinutes}) }}
                    </p>
                </div>

                <div class="flex flex-wrap items-start gap-4">
                    <div class="w-32" title="{{ 'game.zone.life.tooltip'|trans }}">
                        <div class="ds-meter__head">
                            <span>❤️ {{ 'game.home.player.life'|trans }}</span>
                            <span>{{ life.current }} / {{ life.max }}</span>
                        </div>
                        <div class="ds-meter">
                            <div class="ds-meter__fill ds-meter__fill--hp" style="width: {{ life.max > 0 ? ((life.current / life.max) * 100)|round : 0 }}%"></div>
                        </div>
                        {% if life.fullIn is not null %}
                            <p class="ds-num ds-num--sm ds-num--muted text-left mt-1">
                                {{ 'game.zone.life.full_in'|trans({'%minutes%': (life.fullIn / 60)|round(0, 'ceil')}) }}
                            </p>
                        {% endif %}
                    </div>

                    <div class="w-32" title="{{ 'game.zone.energy.tooltip'|trans }}">
                        <div class="ds-meter__head">
                            <span>⚡ {{ 'game.home.player.energy'|trans }}</span>
                            <span>{{ energy.current }} / {{ energy.max }}</span>
                        </div>
                        <div class="ds-meter">
                            <div class="ds-meter__fill" style="width: {{ energy.max > 0 ? ((energy.current / energy.max) * 100)|round : 0 }}%"></div>
                        </div>
                        {% if energy.nextPointIn is not null %}
                            <p class="ds-num ds-num--sm ds-num--muted text-left mt-1">
                                {{ 'game.zone.energy.next_point'|trans({'%minutes%': (energy.nextPointIn / 60)|round(0, 'ceil')}) }}
                            </p>
                        {% endif %}
                    </div>

                    <div class="w-24">
                        <div class="ds-meter__head">
                            <span>🪙 {{ 'game.currency'|trans }}</span>
                        </div>
                        <p class="ds-num ds-num--lg">{{ player.gils|number_format(0, ',', ' ') }}</p>
                    </div>
                </div>
            </div>

            <div class="mt-4 flex flex-wrap items-center gap-3">
                {% if resume.actionable %}
                    <a href="{{ path(resume.route) }}" class="ds-btn ds-btn--primary">
                        {{ ('game.home.resume.action.' ~ resume.state)|trans({'%zone%': resumeZone}) }}
                    </a>
                {% else %}
                    {# Registre 2 de GAME_ZONE_ACTIONS.md : ce qui tourne sans le
                       joueur s'affiche comme un etat, jamais comme un bouton. #}
                    <span class="ds-banner">
                        {{ 'game.home.resume.waiting'|trans({'%minutes%': resumeMinutes}) }}
                    </span>
                    <a href="{{ path(resume.route) }}" class="ds-btn ds-btn--secondary">
                        {{ 'game.home.resume.action.watch'|trans }}
                    </a>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6">

        {# ===== COLONNE PRINCIPALE ===== #}
        <div class="lg:col-span-2 space-y-4 sm:space-y-6">

            {# ===== 2. CE QUI VOUS ATTEND ===== #}
            <div class="game-card">
                <div class="game-card-header flex items-center justify-between">
                    <h2 class="ds-name">{{ 'game.home.pending.title'|trans }}</h2>
                    {% if pending|length > 0 %}
                        <span class="ds-num ds-num--sm">{{ pending|length }}</span>
                    {% endif %}
                </div>
                <div class="game-card-body space-y-2">
                    {% if pending|length > 0 %}
                        {% for item in pending %}
                            <a href="{{ path(item.route, item.routeParams) }}" class="ds-row">
                                <span class="ds-row__icon text-xl leading-none">
                                    {{ ('game.home.pending.' ~ item.key ~ '.icon')|trans }}
                                </span>
                                <span class="ds-row__body">
                                    <span class="ds-row__name block truncate">{{ ('game.home.pending.' ~ item.key ~ '.title')|trans(item.params) }}</span>
                                    <span class="ds-row__meta block">{{ ('game.home.pending.' ~ item.key ~ '.hint')|trans }}</span>
                                </span>
                                <span class="ds-seal {{ item.tone == 'gain' ? 'ds-seal--gain' : (item.tone == 'loss' ? 'ds-seal--loss' : '') }}">
                                    {{ ('game.home.pending.tone.' ~ item.tone)|trans }}
                                </span>
                            </a>
                        {% endfor %}
                    {% else %}
                        <div class="ds-empty">
                            <p class="ds-empty__title">{{ 'game.home.pending.empty'|trans }}</p>
                            <p class="ds-empty__hint">{{ 'game.home.pending.empty_hint'|trans }}</p>
                            <a href="{{ path('app_game_zone') }}" class="ds-btn ds-btn--secondary ds-btn--sm">
                                {{ 'game.home.pending.empty_action'|trans }}
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# ===== 3. LE RECAP — ce que le personnage vient de faire ===== #}
            <div class="game-card">
                <div class="game-card-header flex items-center justify-between">
                    <h2 class="ds-name">{{ 'game.home.recap.title'|trans }}</h2>
                    <a href="{{ path('app_game_journal') }}" class="ds-btn ds-btn--quiet ds-btn--sm">
                        {{ 'game.home.recap.view_all'|trans }}
                    </a>
                </div>
                <div class="game-card-body">
                    {% if recap.isEmpty %}
                        <div class="ds-empty">
                            <p class="ds-empty__title">{{ 'game.home.recap.empty'|trans }}</p>
                            <p class="ds-empty__hint">{{ 'game.home.recap.empty_hint'|trans }}</p>
                        </div>
                    {% else %}
                        <div class="flex flex-wrap gap-2 mb-3">
                            {% for type, count in recap.counts %}
                                <span class="ds-pill">
                                    {{ ('game.journal.type.' ~ type)|trans }}
                                    <span class="ds-num ds-num--sm">{{ count }}</span>
                                </span>
                            {% endfor %}
                        </div>
                        <div class="space-y-0">
                            {% for entry in recap.entries %}
                                <div class="ds-log">
                                    <span class="ds-log__turn">{{ entry.createdAt|date('H:i') }}</span>
                                    <span class="min-w-0">{{ entry.message }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# ===== COLONNE LATERALE ===== #}
        <div class="space-y-4 sm:space-y-6">

            {# ===== 4. PROGRESSION — la seule mesure d'avancement du jeu ===== #}
            <div class="game-card">
                <div class="game-card-header flex items-center justify-between">
                    <h2 class="ds-name">{{ 'game.home.domains.title'|trans }}</h2>
                    <a href="{{ path('app_game_skills') }}" class="ds-btn ds-btn--quiet ds-btn--sm">
                        {{ 'game.home.domains.view_all'|trans }}
                    </a>
                </div>
                <div class="game-card-body space-y-3">
                    {% if domainExperiences|length > 0 %}
                        {% for domainExp in domainExperiences %}
                            {% set totalXp = domainExp.totalExperience %}
                            {% set availableXp = domainExp.availableExperience %}
                            {% set usedPct = totalXp > 0 ? min(((totalXp - availableXp) / totalXp * 100)|round(0, 'floor'), 100) : 0 %}
                            <div>
                                <div class="ds-meter__head">
                                    <span class="truncate">{{ domainExp.domain|localized_domain_title }}</span>
                                    <span>{{ totalXp }} XP</span>
                                </div>
                                <div class="ds-meter">
                                    <div class="ds-meter__fill ds-meter__fill--xp" style="width: {{ usedPct }}%"></div>
                                </div>
                                {% if availableXp > 0 %}
                                    <p class="ds-num ds-num--sm ds-num--gain text-left mt-1">
                                        {{ 'game.home.domains.available_xp'|trans({'%xp%': availableXp}) }}
                                    </p>
                                {% endif %}
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="ds-empty">
                            <p class="ds-empty__title">{{ 'game.home.domains.empty'|trans }}</p>
                            <p class="ds-empty__hint">{{ 'game.home.domains.empty_hint'|trans }}</p>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# ===== 5. QUETES EN COURS — le fil narratif, pas son detail ===== #}
            <div class="game-card">
                <div class="game-card-header flex items-center justify-between">
                    <h2 class="ds-name">{{ 'game.home.quests.title'|trans }}</h2>
                    <a href="{{ path('app_game_quests') }}" class="ds-btn ds-btn--quiet ds-btn--sm">
                        {{ 'game.home.quests.view_all_short'|trans }}
                    </a>
                </div>
                <div class="game-card-body space-y-3">
                    {% if quests|length > 0 %}
                        {% for line in quests %}
                            <div>
                                <div class="ds-meter__head">
                                    <span class="truncate">{{ line.quest|localized_quest_name }}</span>
                                    <span>{{ line.percent }}%</span>
                                </div>
                                <div class="ds-meter">
                                    <div class="ds-meter__fill {{ line.percent >= 100 ? 'ds-meter__fill--gain' : '' }}" style="width: {{ line.percent }}%"></div>
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="ds-empty">
                            <p class="ds-empty__title">{{ 'game.home.quests.empty'|trans }}</p>
                            <p class="ds-empty__hint">{{ 'game.home.quests.empty_hint'|trans }}</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
