{% extends 'game/game.html.twig' %}

{% block title %}{{ 'game.zone.title'|trans }}{% endblock %}

{% block game_content %}
<div class="game-page">
    <div class="game-card">
        <div class="game-card-header">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <div>
                    <h2 class="text-base sm:text-lg font-semibold text-white">{{ 'game.zone.title'|trans }}</h2>
                    <p class="text-gray-400 text-xs mt-0.5">{{ 'game.zone.subtitle'|trans }}</p>
                </div>
                <div class="flex items-start gap-4">
                    {% if phase is defined and phase %}
                        <div class="text-right" title="{{ ('game.zone.phase.' ~ phase ~ '_tooltip')|trans }}">
                            <p class="text-sm font-semibold {{ phase == 'night' ? 'text-indigo-300' : 'text-amber-200' }}">
                                {{ phase == 'night' ? '🌙' : '☀️' }} {{ ('game.zone.phase.' ~ phase)|trans }}
                            </p>
                        </div>
                    {% endif %}
                    {% if life %}
                        <div class="text-right" title="{{ 'game.zone.life.tooltip'|trans }}">
                            <p class="text-sm font-semibold {{ life.current < (life.max / 2) ? 'text-red-300' : 'text-rose-300' }}">
                                ❤️ {{ 'game.zone.life.label'|trans }} {{ life.current }}/{{ life.max }}
                            </p>
                            {% if life.fullIn is not null %}
                                <p class="text-[10px] text-gray-500">
                                    {{ 'game.zone.life.full_in'|trans({'%minutes%': (life.fullIn / 60)|round(0, 'ceil')}) }}
                                </p>
                            {% endif %}
                            <div class="mt-1 h-1.5 w-32 rounded-full bg-gray-800 overflow-hidden">
                                <div class="h-full {{ life.current < (life.max / 2) ? 'bg-red-500/80' : 'bg-rose-400/80' }}" style="width: {{ life.max > 0 ? ((life.current / life.max) * 100)|round : 0 }}%"></div>
                            </div>
                        </div>
                    {% endif %}
                    {% if energy %}
                        <div class="text-right" title="{{ 'game.zone.energy.tooltip'|trans }}">
                            <p class="text-sm font-semibold text-amber-300">
                                ⚡ {{ 'game.zone.energy.label'|trans }} {{ energy.current }}/{{ energy.max }}
                            </p>
                            {% if energy.nextPointIn is not null %}
                                <p class="text-[10px] text-gray-500">
                                    {{ 'game.zone.energy.next_point'|trans({'%minutes%': (energy.nextPointIn / 60)|round(0, 'ceil')}) }}
                                </p>
                            {% endif %}
                            <div class="mt-1 h-1.5 w-32 rounded-full bg-gray-800 overflow-hidden">
                                <div class="h-full bg-amber-400/80" style="width: {{ energy.max > 0 ? ((energy.current / energy.max) * 100)|round : 0 }}%"></div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="game-card-body">
            {% if zone is null %}
                <div class="text-center py-8">
                    <p class="text-white text-sm font-medium">{{ 'game.zone.no_zone.title'|trans }}</p>
                    <p class="text-gray-500 text-sm mt-1">{{ 'game.zone.no_zone.description'|trans }}</p>
                </div>
            {% else %}
                {% for label, messages in app.flashes(['success', 'error']) %}
                    {% for message in messages %}
                        <div class="mb-3 px-3 py-2 rounded-md text-sm {{ label == 'success' ? 'bg-emerald-900/40 border border-emerald-700/50 text-emerald-200' : 'bg-red-900/40 border border-red-700/50 text-red-200' }}">
                            {{ message|trans }}
                        </div>
                    {% endfor %}
                {% endfor %}

                {% for result in app.flashes('explore_result') %}
                    <div class="mb-3 px-3 py-2 rounded-md text-sm bg-indigo-900/40 border border-indigo-700/50 text-indigo-200">
                        🧭 {{ result.key|trans(result.params) }}
                    </div>
                {% endfor %}

                {% for result in app.flashes('gather_result') %}
                    <div class="mb-3 px-3 py-2 rounded-md text-sm bg-emerald-900/40 border border-emerald-700/50 text-emerald-200">
                        ⛏️ {{ result.key|trans(result.params) }}
                    </div>
                {% endfor %}

                {% for result in app.flashes('expedition_result') %}
                    <div class="mb-3 px-3 py-2 rounded-md text-sm bg-amber-900/30 border border-amber-700/50 text-amber-100">
                        🧭 {{ 'game.zone.expedition.result'|trans({'%zone%': result.zone, '%gils%': result.gils}) }}
                        {% if result.items is not empty %}
                            <span class="block text-xs text-amber-200/80 mt-0.5">
                                {% for item in result.items %}{{ item.quantity }}× {{ item.name }}{% if not loop.last %}, {% endif %}{% endfor %}
                            </span>
                        {% endif %}
                    </div>
                {% endfor %}

                {% if justArrived %}
                    <div class="mb-3 px-3 py-2 rounded-md text-sm bg-emerald-900/40 border border-emerald-700/50 text-emerald-200">
                        {{ 'game.zone.travel.flash.arrived'|trans }}
                    </div>
                {% endif %}

                {% if travel %}
                    <div class="mb-4 px-3 py-2.5 rounded-md bg-sky-900/30 border border-sky-700/50">
                        <p class="text-sm text-sky-200 font-medium">
                            {{ 'game.zone.travel.in_progress'|trans({'%zone%': travel.destination.localizedName(app.request.locale)}) }}
                        </p>
                        <p class="text-xs text-sky-300/80 mt-0.5">
                            {% if travel.remainingSeconds < 60 %}
                                {{ 'game.zone.travel.arrival_imminent'|trans }}
                            {% else %}
                                {{ 'game.zone.travel.arrival_in'|trans({'%minutes%': (travel.remainingSeconds / 60)|round(0, 'ceil')}) }}
                            {% endif %}
                        </p>
                    </div>
                {% endif %}

                {# ── Expedition time-gated (ZON-13) ──────────────── #}
                {% if expedition %}
                    {% if expedition.active %}
                        <div class="mb-4 px-3 py-2.5 rounded-md bg-amber-900/25 border border-amber-700/50">
                            {% if expedition.ready %}
                                <p class="text-sm text-amber-100 font-medium">
                                    🧭 {{ 'game.zone.expedition.ready'|trans({'%zone%': expedition.zone.localizedName(app.request.locale)}) }}
                                </p>
                                <form method="post" action="{{ path('app_game_zone_expedition_claim') }}" class="mt-2">
                                    <input type="hidden" name="_token" value="{{ csrf_token('expedition_claim') }}">
                                    <button type="submit"
                                            class="inline-flex items-center rounded-md px-3 py-1.5 text-sm font-medium bg-amber-800/50 border border-amber-500 text-amber-50 hover:bg-amber-700/60">
                                        {{ 'game.zone.expedition.claim'|trans }}
                                    </button>
                                </form>
                            {% else %}
                                <p class="text-sm text-amber-100 font-medium">
                                    🧭 {{ 'game.zone.expedition.in_progress'|trans({'%zone%': expedition.zone.localizedName(app.request.locale)}) }}
                                </p>
                                <p class="text-xs text-amber-200/80 mt-0.5">
                                    {% if expedition.remainingSeconds < 60 %}
                                        {{ 'game.zone.expedition.return_imminent'|trans }}
                                    {% else %}
                                        {{ 'game.zone.expedition.return_in'|trans({'%minutes%': (expedition.remainingSeconds / 60)|round(0, 'ceil')}) }}
                                    {% endif %}
                                </p>
                            {% endif %}
                        </div>
                    {% elseif expedition.eligible and not travel %}
                        <div class="mb-4 px-3 py-2.5 rounded-md bg-amber-900/15 border border-amber-800/40">
                            <p class="text-sm font-semibold text-amber-100">{{ 'game.zone.expedition.heading'|trans }}</p>
                            <p class="text-xs text-amber-200/70 mt-0.5 mb-2">{{ 'game.zone.expedition.subtitle'|trans }}</p>
                            <div class="flex flex-wrap gap-2">
                                {% for key, seconds in expedition.durations %}
                                    <form method="post" action="{{ path('app_game_zone_expedition_start', {durationKey: key}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('expedition_start_' ~ key) }}">
                                        <button type="submit"
                                                class="inline-flex items-center rounded-md px-3 py-1.5 text-sm font-medium bg-amber-900/40 border border-amber-600 text-amber-100 hover:bg-amber-800/50">
                                            {{ ('game.zone.expedition.duration.' ~ key)|trans }}
                                            <span class="ml-2 text-[10px] uppercase tracking-wide text-amber-300/90">{{ (seconds / 3600)|round(1) }} h</span>
                                        </button>
                                    </form>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                {% endif %}

                {# ── Evenements de zone (ZON-15) ─────────────────── #}
                {% if zoneEvents is not empty %}
                    <div class="mb-4 space-y-2">
                        {% for event in zoneEvents %}
                            <div class="px-3 py-2.5 rounded-md bg-fuchsia-900/25 border border-fuchsia-700/50">
                                <div class="flex flex-wrap items-center justify-between gap-2">
                                    <div>
                                        <p class="text-sm font-semibold text-fuchsia-100">⚔️ {{ event.name }}
                                            <span class="ml-1 text-[10px] uppercase tracking-wide text-fuchsia-300/80">{{ event.typeLabel }}</span>
                                        </p>
                                        <p class="text-xs text-fuchsia-200/70 mt-0.5">
                                            {% if event.remainingSeconds < 60 %}
                                                {{ 'game.zone.event.ends_imminent'|trans }}
                                            {% else %}
                                                {{ 'game.zone.event.ends_in'|trans({'%minutes%': (event.remainingSeconds / 60)|round(0, 'ceil')}) }}
                                            {% endif %}
                                        </p>
                                    </div>
                                    {% if event.joined %}
                                        <span class="inline-flex items-center rounded-md px-3 py-1.5 text-sm font-medium bg-fuchsia-800/40 border border-fuchsia-600 text-fuchsia-100">
                                            {{ 'game.zone.event.joined'|trans }}
                                        </span>
                                    {% else %}
                                        <form method="post" action="{{ path('app_game_zone_event_join', {id: event.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('zone_event_join_' ~ event.id) }}">
                                            <button type="submit" class="inline-flex items-center rounded-md px-3 py-1.5 text-sm font-medium bg-fuchsia-900/50 border border-fuchsia-600 text-fuchsia-100 hover:bg-fuchsia-800/60">
                                                {{ 'game.zone.event.join'|trans }}
                                                <span class="ml-2 text-[10px] uppercase tracking-wide text-amber-300/90">⚡ {{ event.cost }}</span>
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {# ── En-tete de zone ─────────────────────────────── #}
                <div class="mb-4">
                    <div class="flex flex-wrap items-center gap-2">
                        <h3 class="text-lg font-semibold text-white">{{ zone.localizedName(app.request.locale) }}</h3>
                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-gray-800/60 border border-gray-700 text-gray-300">
                            {{ (typeLabels[zone.type] ?? 'game.zone.type.wilderness')|trans }}
                        </span>
                        {% if zone.isSafe %}
                            <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-emerald-900/40 border border-emerald-700/50 text-emerald-200">
                                {{ 'game.zone.safe_badge'|trans }}
                            </span>
                        {% endif %}
                    </div>
                    {% set description = zone.localizedDescription(app.request.locale) %}
                    {% if description %}
                        <p class="text-gray-400 text-sm mt-2">{{ description }}</p>
                    {% endif %}
                    {% if zone.illustrationPath %}
                        <img src="{{ asset('images/' ~ zone.illustrationPath) }}" alt="{{ zone.localizedName(app.request.locale) }}"
                             class="mt-3 rounded-lg border border-gray-700 max-h-48 w-full object-cover">
                    {% endif %}
                </div>

                {# ── Actions de zone (ZON-08..10) ────────────────── #}
                {% if actions is not empty %}
                    <div class="mb-4">
                        <h4 class="text-sm font-semibold text-gray-200 mb-2">{{ 'game.zone.actions.heading'|trans }}</h4>
                        <div class="flex flex-wrap gap-2">
                            {% for action in actions %}
                                {% if action.key == 'explore' and action.enabled %}
                                    <form method="post" action="{{ path('app_game_zone_explore') }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('explore') }}">
                                        <button type="submit"
                                                {% if travel %}disabled title="{{ 'game.zone.travel.error.already_traveling'|trans }}"{% endif %}
                                                class="inline-flex items-center rounded-md px-3 py-1.5 text-sm font-medium {% if travel %}bg-gray-800/60 border border-gray-700 text-gray-500 cursor-not-allowed{% else %}bg-indigo-900/40 border border-indigo-600 text-indigo-100 hover:bg-indigo-800/50{% endif %}">
                                            {{ action.label|trans }}
                                            <span class="ml-2 text-[10px] uppercase tracking-wide {% if travel %}text-gray-600{% else %}text-amber-300/90{% endif %}">⚡ {{ action.cost }}</span>
                                        </button>
                                    </form>
                                {% endif %}
                                {# 'hunt' (ZON-09) et 'gather' (ZON-10) ont leur bloc dedie ci-dessous #}
                            {% endfor %}
                        </div>
                    </div>

                    {# ── Chasser : proies ciblees du bestiaire (ZON-09) ── #}
                    {% if not zone.isSafe %}
                        <div class="mb-4">
                            <h4 class="text-sm font-semibold text-gray-200 mb-2">{{ 'game.zone.hunt.heading'|trans }}</h4>
                            {% if huntTargets is empty %}
                                <p class="text-gray-500 text-sm">{{ 'game.zone.hunt.empty'|trans }}</p>
                            {% else %}
                                <div class="flex flex-wrap gap-2">
                                    {% for target in huntTargets %}
                                        <form method="post" action="{{ path('app_game_zone_hunt', {id: target.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('hunt_' ~ target.id) }}">
                                            <button type="submit"
                                                    {% if travel %}disabled title="{{ 'game.zone.travel.error.already_traveling'|trans }}"{% endif %}
                                                    class="inline-flex items-center rounded-md px-3 py-1.5 text-sm font-medium {% if travel %}bg-gray-800/60 border border-gray-700 text-gray-500 cursor-not-allowed{% else %}bg-rose-900/40 border border-rose-600 text-rose-100 hover:bg-rose-800/50{% endif %}">
                                                🎯 {{ target.localizedName(app.request.locale) }}
                                                <span class="ml-2 text-[10px] uppercase tracking-wide {% if travel %}text-gray-600{% else %}text-amber-300/90{% endif %}">⚡ {{ huntCost }}</span>
                                            </button>
                                        </form>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}

                    {# ── Recolter : filons partages de la zone (ZON-10) ── #}
                    {% if gatherables is not empty %}
                        {% set professionIcons = {'mining': '⛏️', 'herbalism': '🌿', 'fishing': '🎣'} %}
                        <div class="mb-4">
                            <h4 class="text-sm font-semibold text-gray-200 mb-2">{{ 'game.zone.gather.heading'|trans }}</h4>
                            <div class="flex flex-wrap gap-2">
                                {% for gatherable in gatherables %}
                                    {% set depleted = gatherable.depleted %}
                                    {% set blocked = depleted or travel %}
                                    <div class="rounded-md border px-3 py-2 min-w-[9rem] {% if depleted %}bg-gray-800/40 border-gray-700/60{% else %}bg-teal-900/30 border-teal-700/50{% endif %}">
                                        <div class="flex items-center justify-between gap-2">
                                            <span class="text-sm text-white">
                                                {{ professionIcons[gatherable.profession] ?? '🧺' }} {{ gatherable.itemName }}
                                            </span>
                                            <span class="text-[10px] uppercase tracking-wide {% if blocked %}text-gray-600{% else %}text-amber-300/90{% endif %}">⚡ {{ gatherCost }}</span>
                                        </div>
                                        <div class="mt-1.5 flex items-center gap-2">
                                            <div class="h-1.5 flex-1 rounded-full bg-gray-800 overflow-hidden">
                                                <div class="h-full {% if depleted %}bg-gray-600{% else %}bg-teal-400/80{% endif %}" style="width: {{ gatherable.capacity > 0 ? ((gatherable.stock / gatherable.capacity) * 100)|round : 0 }}%"></div>
                                            </div>
                                            <span class="text-[10px] text-gray-400 tabular-nums">{{ gatherable.stock }}/{{ gatherable.capacity }}</span>
                                        </div>
                                        {% if depleted %}
                                            <p class="mt-1 text-[10px] text-gray-500">
                                                {% if gatherable.respawnRemaining > 0 %}
                                                    {{ 'game.zone.gather.respawn_in'|trans({'%minutes%': (gatherable.respawnRemaining / 60)|round(0, 'ceil')}) }}
                                                {% else %}
                                                    {{ 'game.zone.gather.depleted'|trans }}
                                                {% endif %}
                                            </p>
                                        {% else %}
                                            <form method="post" action="{{ path('app_game_zone_gather', {slug: gatherable.slug}) }}" class="mt-1.5">
                                                <input type="hidden" name="_token" value="{{ csrf_token('gather_' ~ gatherable.slug) }}">
                                                <button type="submit"
                                                        {% if travel %}disabled title="{{ 'game.zone.travel.error.already_traveling'|trans }}"{% endif %}
                                                        class="w-full inline-flex items-center justify-center rounded-md px-2.5 py-1 text-xs font-medium {% if travel %}bg-gray-800/60 border border-gray-700 text-gray-500 cursor-not-allowed{% else %}bg-teal-900/40 border border-teal-600 text-teal-100 hover:bg-teal-800/50{% endif %}">
                                                    {{ 'game.zone.actions.gather'|trans }}
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                {% endif %}

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {# ── Connexions ──────────────────────────────── #}
                    <div>
                        <h4 class="text-sm font-semibold text-gray-200 mb-2">{{ 'game.zone.connections.heading'|trans }}</h4>
                        {% if connections is empty %}
                            <p class="text-gray-500 text-sm">{{ 'game.zone.connections.empty'|trans }}</p>
                        {% else %}
                            <ul class="space-y-1.5">
                                {% for connection in connections %}
                                    {% set locked = connection.requiresDiscovery and connection.toZone.id not in visitedZoneIds %}
                                    <li class="flex items-center justify-between gap-2 rounded-md bg-gray-800/40 border border-gray-700/60 px-3 py-2">
                                        <span class="text-sm text-white">
                                            {{ connection.toZone.localizedName(app.request.locale) }}
                                            {% if locked %}
                                                <span class="ml-1 text-xs text-amber-400/80" title="{{ 'game.zone.connections.locked'|trans }}">🔒</span>
                                            {% endif %}
                                        </span>
                                        <span class="flex items-center gap-2">
                                            <span class="text-xs text-gray-400">
                                                {% if connection.travelSeconds == 0 %}
                                                    {{ 'game.zone.connections.travel_instant'|trans }}
                                                {% else %}
                                                    {{ 'game.zone.connections.travel_minutes'|trans({'%count%': (connection.travelSeconds / 60)|round}) }}
                                                {% endif %}
                                            </span>
                                            {% if locked %}
                                                <span class="inline-flex items-center rounded-md px-2.5 py-1 text-xs font-medium bg-gray-800/60 border border-gray-700 text-gray-600">
                                                    {{ 'game.zone.travel.button'|trans }}
                                                </span>
                                            {% elseif travel %}
                                                <span class="inline-flex items-center rounded-md px-2.5 py-1 text-xs font-medium bg-gray-800/60 border border-gray-700 text-gray-600"
                                                      title="{{ 'game.zone.travel.error.already_traveling'|trans }}">
                                                    {{ 'game.zone.travel.button'|trans }}
                                                </span>
                                            {% else %}
                                                <form method="post" action="{{ path('app_game_zone_travel', {id: connection.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('travel_' ~ connection.id) }}">
                                                    <button type="submit"
                                                            class="inline-flex items-center rounded-md px-2.5 py-1 text-xs font-medium bg-purple-900/40 border border-purple-600 text-purple-100 hover:bg-purple-800/50">
                                                        {{ 'game.zone.travel.button'|trans }}
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </span>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>

                    {# ── Presence & chat de zone (ZON-14) ────────── #}
                    <div {% if zoneChat %}data-controller="zone-chat"
                         data-zone-chat-mercure-url-value="{{ (mercure_url is defined and mercure_url starts with 'http') ? mercure_url : (app.request.schemeAndHttpHost ~ '/.well-known/mercure') }}"
                         data-zone-chat-zone-id-value="{{ zoneChat.zoneId }}"
                         data-zone-chat-send-url-value="{{ path('app_game_chat_send') }}"
                         data-zone-chat-presence-url-value="{{ path('app_game_zone_presence') }}"
                         data-zone-chat-invite-url-value="{{ path('app_game_party_invite', {playerId: '__ID__'}) }}"
                         data-zone-chat-profile-url-value="{{ path('app_game_player_profile', {id: '__ID__'}) }}"{% endif %}>
                        <h4 class="text-sm font-semibold text-gray-200 mb-2">{{ 'game.zone.players.heading'|trans }}</h4>
                        <div data-zone-chat-target="presence" class="space-y-1">
                            {% if playersPresent is empty %}
                                <p class="text-gray-500 text-sm">{{ 'game.zone.players.empty'|trans }}</p>
                            {% else %}
                                {% for presentPlayer in playersPresent %}
                                    <div class="flex items-center justify-between gap-2 rounded-md bg-gray-800/40 border border-gray-700/60 px-3 py-1.5">
                                        <a href="{{ path('app_game_player_profile', {id: presentPlayer.id}) }}" class="text-sm text-white hover:text-sky-200 truncate">{{ presentPlayer.name }}</a>
                                        {% if app.user and presentPlayer.user is defined and presentPlayer.user == app.user %}
                                            <span class="text-[10px] uppercase tracking-wide text-purple-300">{{ 'game.zone.players.you'|trans }}</span>
                                        {% else %}
                                            <form method="post" action="{{ path('app_game_party_invite', {playerId: presentPlayer.id}) }}">
                                                <button type="submit" class="text-[10px] px-1.5 py-0.5 rounded bg-indigo-900/50 border border-indigo-700 text-indigo-200 hover:bg-indigo-800/60" title="{{ 'game.zone.players.invite'|trans }}">+</button>
                                            </form>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            {% endif %}
                        </div>

                        {# ── Chat de zone (temps reel Mercure) ────── #}
                        {% if zoneChat %}
                            <h4 class="text-sm font-semibold text-gray-200 mb-2 mt-4">{{ 'game.zone.chat.heading'|trans }}</h4>
                            <div class="rounded-md bg-gray-900/60 border border-gray-700/60">
                                <div data-zone-chat-target="messages" class="h-40 overflow-y-auto px-3 py-2 text-xs">
                                    {% for message in zoneChat.messages %}
                                        <div class="text-xs py-0.5">
                                            <span class="text-gray-600 mr-1">{{ message.createdAt ? message.createdAt|date('H:i') : '' }}</span>
                                            <span class="font-semibold text-sky-300 mr-1">{{ message.sender.name }}:</span>
                                            <span class="text-gray-200">{{ message.content }}</span>
                                        </div>
                                    {% endfor %}
                                </div>
                                <form data-action="zone-chat#send" class="flex gap-1 border-t border-gray-700/60 p-2">
                                    <input data-zone-chat-target="input" type="text" maxlength="500"
                                           placeholder="{{ 'game.zone.chat.placeholder'|trans }}"
                                           class="flex-1 rounded bg-gray-800 border border-gray-700 px-2 py-1 text-xs text-gray-100 focus:outline-none focus:border-sky-600">
                                    <button type="submit" class="rounded bg-sky-900/50 border border-sky-700 text-sky-200 hover:bg-sky-800/60 px-3 py-1 text-xs font-medium">{{ 'game.zone.chat.send'|trans }}</button>
                                </form>
                            </div>
                        {% endif %}

                        {# ── Points d'interet ────────────────────── #}
                        <h4 class="text-sm font-semibold text-gray-200 mb-2 mt-4">{{ 'game.zone.poi.heading'|trans }}</h4>
                        {% if poiCounts is empty %}
                            <p class="text-gray-500 text-sm">{{ 'game.zone.poi.empty'|trans }}</p>
                        {% else %}
                            <ul class="space-y-1">
                                {% for type, count in poiCounts %}
                                    <li class="flex items-center justify-between text-sm text-gray-300">
                                        <span>{{ (poiLabels[type] ?? type)|trans }}</span>
                                        <span class="text-gray-500">× {{ count }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
