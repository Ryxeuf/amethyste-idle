{% extends 'game/game.html.twig' %}

{% block title %}{{ 'game.zone.title'|trans }}{% endblock %}

{# Duree lisible pour la barre de voyage : `12:34`, ou `1:02:03` au-dela d'une
   heure. Rendue cote serveur pour que la carte reste lisible sans JavaScript ;
   le controleur Stimulus reprend ensuite le meme format a chaque seconde. #}
{% macro travel_duration(seconds) %}
    {%- set h = (seconds / 3600)|round(0, 'floor') -%}
    {%- set m = ((seconds % 3600) / 60)|round(0, 'floor') -%}
    {%- set s = seconds % 60 -%}
    {%- if h > 0 -%}
        {{- h }}:{{ '%02d'|format(m) }}:{{ '%02d'|format(s) -}}
    {%- else -%}
        {{- m }}:{{ '%02d'|format(s) -}}
    {%- endif -%}
{% endmacro %}

{% block game_content %}
    {{ include('components/_coach_mark.html.twig', {coachMark: coach_mark('zone')}) }}
{# L'import vit dans le bloc : en heritage Twig, ce qui est declare au niveau
   du template n'est pas visible depuis les blocs rendus par le parent. #}
{% import _self as fmt %}
{#
   Ecran de zone — section 07 du systeme de design.

   Trois regles tenues ici :
   1. une seule action primaire : « Explorer ». Chasser, recolter, voyager sont
      des actions secondaires, l'abandon et la fuite du texte ;
   2. tout chiffre (energie, PV, stock d'un filon, duree de voyage) est en
      monospace, aligne a droite ;
   3. chaque liste vide dit ce qu'il faut faire au lieu d'afficher « vide ».
#}
<div class="game-page">
    <div class="game-card">
        <div class="game-card-header">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <div>
                    <h2 class="ds-name">{{ 'game.zone.title'|trans }}</h2>
                    <p class="ds-hint">{{ 'game.zone.subtitle'|trans }}</p>
                </div>
                <div class="flex flex-wrap items-start gap-4">
                    {% if phase is defined and phase %}
                        <div title="{{ ('game.zone.phase.' ~ phase ~ '_tooltip')|trans }}">
                            <span class="ds-seal {{ phase == 'night' ? 'ds-seal-epic' : 'ds-seal-legendary' }}">
                                {{ phase == 'night' ? '🌙' : '☀️' }} {{ ('game.zone.phase.' ~ phase)|trans }}
                            </span>
                        </div>
                    {% endif %}
                    {% if life %}
                        <div class="w-32" title="{{ 'game.zone.life.tooltip'|trans }}">
                            <div class="ds-meter__head">
                                <span>❤️ {{ 'game.zone.life.label'|trans }}</span>
                                <span>{{ life.current }} / {{ life.max }}</span>
                            </div>
                            <div class="ds-meter">
                                <div class="ds-meter__fill ds-meter__fill--hp" style="width: {{ life.max > 0 ? ((life.current / life.max) * 100)|round : 0 }}%"></div>
                            </div>
                            {% if life.fullIn is not null %}
                                <p class="ds-num ds-num--sm ds-num--muted text-left mt-1">
                                    {{ 'game.zone.life.full_in'|trans({'%minutes%': (life.fullIn / 60)|round(0, 'ceil')}) }}
                                </p>
                            {% endif %}
                        </div>
                    {% endif %}
                    {% if energy %}
                        <div class="w-32" title="{{ 'game.zone.energy.tooltip'|trans }}" data-testid="zone-energy">
                            <div class="ds-meter__head">
                                <span>⚡ {{ 'game.zone.energy.label'|trans }}</span>
                                <span>{{ energy.current }} / {{ energy.max }}</span>
                            </div>
                            <div class="ds-meter">
                                <div class="ds-meter__fill" style="width: {{ energy.max > 0 ? ((energy.current / energy.max) * 100)|round : 0 }}%"></div>
                            </div>
                            {% if energy.nextPointIn is not null %}
                                <p class="ds-num ds-num--sm ds-num--muted text-left mt-1">
                                    {{ 'game.zone.energy.next_point'|trans({'%minutes%': (energy.nextPointIn / 60)|round(0, 'ceil')}) }}
                                </p>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="game-card-body">
            {% if zone is null %}
                <div class="ds-empty">
                    <p class="ds-empty__title">{{ 'game.zone.no_zone.title'|trans }}</p>
                    <p class="ds-empty__hint">{{ 'game.zone.no_zone.description'|trans }}</p>
                </div>
            {% else %}
                {% for label, messages in app.flashes(['success', 'error']) %}
                    {% for message in messages %}
                        <div class="ds-banner {{ label == 'success' ? 'ds-banner--gain' : 'ds-banner--loss' }} mb-3">
                            {{ message|trans }}
                        </div>
                    {% endfor %}
                {% endfor %}

                {% for result in app.flashes('explore_result') %}
                    <div class="ds-banner mb-3">
                        🧭 {{ result.key|trans(result.params) }}
                    </div>
                {% endfor %}

                {% for result in app.flashes('gather_result') %}
                    <div class="ds-banner ds-banner--gain mb-3">
                        ⛏️ {{ result.key|trans(result.params) }}
                    </div>
                {% endfor %}

                {# FOY-12 — restaurer est un acte de gouvernement : il s'annonce. #}
                {% for result in app.flashes('restoration_result') %}
                    <div class="ds-banner ds-banner--gain mb-3">
                        🛠️ {{ result.key|trans(result.params) }}
                    </div>
                {% endfor %}

                {% for result in app.flashes('commission_result') %}
                    <div class="ds-banner ds-banner--gain mb-3">
                        📜 {{ ('game.commission.delivered.' ~ result.reward)|trans({
                            '%grains%': result.grains,
                            '%gils%': result.gils,
                            '%energy%': result.energy,
                        }) }}
                    </div>
                {% endfor %}

                {% for result in app.flashes('boss_result') %}
                    <div class="ds-banner {{ result.defeated ? 'ds-banner--gain' : 'ds-banner--loss' }} mb-3">
                        {% if result.defeated %}
                            ⚔️ {{ 'game.zone.boss.flash.defeated'|trans({'%damage%': result.damage}) }}
                        {% else %}
                            ⚔️ {{ 'game.zone.boss.flash.hit'|trans({'%damage%': result.damage, '%current%': result.hpCurrent, '%max%': result.hpMax}) }}
                        {% endif %}
                    </div>
                {% endfor %}

                {% for result in app.flashes('expedition_result') %}
                    <div class="ds-banner ds-banner--gain mb-3">
                        <span>
                            🧭 {{ 'game.zone.expedition.result'|trans({'%zone%': result.zone, '%gils%': result.gils}) }}
                            {% if result.items is not empty %}
                                <span class="block ds-hint mt-0.5">
                                    {% for item in result.items %}{{ item.quantity }}× {{ item.name }}{% if not loop.last %}, {% endif %}{% endfor %}
                                </span>
                            {% endif %}
                        </span>
                    </div>
                {% endfor %}

                {% if justArrived %}
                    <div class="ds-banner ds-banner--gain mb-3">
                        {{ 'game.zone.travel.flash.arrived'|trans }}
                    </div>
                {% endif %}

                {# ── Voyage en cours ──────────────────────────────── #}
                {# Le trajet se lit comme une jauge : ce qui est parcouru a     #}
                {# gauche, ce qui reste a droite. Le decompte vit cote client   #}
                {# (travel_progress), mais l'arrivee reste reglee par le        #}
                {# serveur au rechargement que ce meme controleur declenche.    #}
                {% if travel %}
                    <div class="ds-card p-3 mb-4"
                         data-testid="zone-travel"
                         data-controller="travel-progress"
                         data-travel-progress-arrives-at-value="{{ travel.arrivesAt.timestamp }}"
                         data-travel-progress-total-value="{{ travel.totalSeconds }}"
                         data-travel-progress-server-now-value="{{ 'now'|date('U') }}">
                        <p class="text-sm font-semibold text-ink">
                            🧳 {{ 'game.zone.travel.in_progress'|trans({'%zone%': travel.destination.localizedName(app.request.locale)}) }}
                        </p>

                        {% if travel.totalSeconds > 0 %}
                            <div class="ds-meter__head mt-2">
                                <span>{{ 'game.zone.travel.elapsed'|trans }}
                                    <span data-travel-progress-target="elapsed">{{ fmt.travel_duration(travel.elapsedSeconds) }}</span>
                                </span>
                                <span>{{ 'game.zone.travel.remaining'|trans }}
                                    <span data-travel-progress-target="remaining">{{ fmt.travel_duration(travel.remainingSeconds) }}</span>
                                </span>
                            </div>
                            <div class="ds-meter ds-meter--tall"
                                 role="progressbar"
                                 aria-valuemin="0"
                                 aria-valuemax="100"
                                 aria-valuenow="{{ ((travel.elapsedSeconds / travel.totalSeconds) * 100)|round }}"
                                 aria-label="{{ 'game.zone.travel.in_progress'|trans({'%zone%': travel.destination.localizedName(app.request.locale)}) }}">
                                <div class="ds-meter__fill" data-travel-progress-target="bar"
                                     style="width: {{ ((travel.elapsedSeconds / travel.totalSeconds) * 100)|round }}%"></div>
                            </div>
                        {% else %}
                            {# Voyage entame avant le suivi du depart : pas de duree #}
                            {# totale, donc pas de barre — le decompte seul.         #}
                            <p class="ds-num ds-num--sm ds-num--muted text-left mt-0.5">
                                {{ 'game.zone.travel.remaining'|trans }}
                                <span data-travel-progress-target="remaining">{{ fmt.travel_duration(travel.remainingSeconds) }}</span>
                            </p>
                        {% endif %}

                        <p class="ds-hint mt-2">{{ 'game.zone.travel.auto_refresh'|trans }}</p>
                    </div>
                {% endif %}

                {# ── Commission de la semaine (RET-02b) ───────────── #}
                {# Le rendez-vous hebdomadaire personnel. Il s'affiche dans  #}
                {# toutes les zones : savoir qu'il faut aller ailleurs fait  #}
                {# partie du rendez-vous. Le blocage se dit — « il faut y    #}
                {# aller » est une information, « impossible » n'en est pas. #}
                {% if commission %}
                    <div class="ds-card p-3 mb-4">
                        <div class="flex items-baseline justify-between gap-2">
                            <p class="ds-label">{{ 'game.commission.heading'|trans }}</p>
                            <span class="ds-num ds-num--sm ds-num--muted">
                                {{ commission.commission.progress }}/{{ commission.commission.target }}
                            </span>
                        </div>

                        <div class="ds-meter mt-2">
                            <div class="ds-meter__fill" style="width: {{ commission.commission.progressPercent }}%"></div>
                        </div>

                        {% if commission.deliveryZone %}
                            <p class="ds-hint mt-1">
                                {{ 'game.commission.deliver_at'|trans({
                                    '%zone%': commission.deliveryZone.localizedName(app.request.locale),
                                }) }}
                            </p>
                        {% endif %}

                        {% if commission.blocker is null %}
                            <p class="text-sm font-semibold text-ink mt-2">{{ 'game.commission.ready'|trans }}</p>
                            <form method="post" action="{{ path('app_game_commission_deliver') }}" class="mt-2 space-y-1">
                                <input type="hidden" name="_token" value="{{ csrf_token('commission_deliver') }}">
                                {% for reward in commission.rewards %}
                                    <button type="submit" name="reward" value="{{ reward.value }}"
                                            class="ds-btn ds-btn--secondary ds-btn--sm w-full">
                                        {{ ('game.commission.reward.' ~ reward.value)|trans }}
                                    </button>
                                {% endfor %}
                            </form>
                        {% else %}
                            <p class="ds-hint mt-2">{{ commission.blocker|trans }}</p>
                        {% endif %}
                    </div>
                {% endif %}

                {# ── Foyer de la zone (FOY-04) ────────────────────── #}
                {# Un compteur qui monte n'est pas un jeu ; un chantier visible #}
                {# en est un. La jauge se lit entre deux paliers, jamais depuis  #}
                {# zero : au Bourg, une barre partant de zero serait pleine a    #}
                {# 97 % et ne bougerait plus, alors que le chemin vers la Cite   #}
                {# reste presque entier.                                         #}
                {% if settlement %}
                    <div class="ds-card p-3 mb-4">
                        <div class="flex items-baseline justify-between gap-2">
                            <p class="ds-label">{{ 'game.zone.settlement.heading'|trans }}</p>
                            <span class="ds-num ds-num--sm ds-num--muted">{{ settlement.total }}</span>
                        </div>

                        <p class="text-sm font-semibold text-ink mt-1">
                            {{ ('game.settlement.rank.' ~ settlement.rank.value)|trans }}
                            {%- if settlement.type %}
                                — {{ ('game.settlement.type.' ~ settlement.type.value)|trans }}
                            {%- endif %}
                        </p>

                        {% if settlement.ebbing %}
                            <p class="ds-hint mt-1">
                                {{ 'game.zone.settlement.ebbing'|trans({
                                    '%rank%': ('game.settlement.rank.' ~ settlement.highestRank.value)|trans,
                                }) }}
                            </p>
                        {% endif %}

                        {# FOY-18 — les parcelles residentielles du rang. `free` peut #}
                        {# etre a zero avec plus de demeures que de parcelles : rien #}
                        {# n'expulse, la capacite ne gate que les nouvelles. #}
                        {% if settlement.housing %}
                            <p class="ds-hint mt-1">
                                {{ 'game.zone.settlement.parcels'|trans({
                                    '%free%': settlement.housing.free,
                                    '%capacity%': settlement.housing.capacity,
                                }) }}
                            </p>
                        {% endif %}

                        {% if settlement.next %}
                            <div class="ds-meter mt-2">
                                <div class="ds-meter__fill" style="width: {{ settlement.next.progress }}%"></div>
                            </div>
                            <p class="ds-num ds-num--sm ds-num--muted text-left mt-1">
                                {{ 'game.zone.settlement.to_next'|trans({
                                    '%count%': settlement.next.missing,
                                    '%rank%': ('game.settlement.rank.' ~ settlement.next.rank.value)|trans,
                                }) }}
                            </p>
                            {% if settlement.next.opens is not empty %}
                                <p class="ds-hint mt-1">
                                    {{ 'game.zone.settlement.opens'|trans }}
                                    {% for service in settlement.next.opens %}
                                        {{- ('game.settlement.service.' ~ service)|trans }}{{ not loop.last ? ', ' : '' }}
                                    {%- endfor %}
                                </p>
                            {% endif %}
                        {% else %}
                            <p class="ds-hint mt-1">{{ 'game.zone.settlement.summit'|trans }}</p>
                        {% endif %}

                        {# ── Vassalite (FOY-09) ──────────────────────────── #}
                        {# Une grande voisine boit la croissance. Le dire est ce #}
                        {# qui transforme un plafond subi en decision de lieu :  #}
                        {# batir a l'ombre d'une capitale coute plus cher.       #}
                        {% if settlement.overlord %}
                            <p class="ds-hint mt-1">
                                {{ 'game.zone.settlement.overlord'|trans({
                                    '%zone%': settlement.overlord.zone,
                                    '%rank%': ('game.settlement.rank.' ~ settlement.overlord.rank.value)|trans,
                                    '%cap%': ('game.settlement.rank.' ~ settlement.overlord.cap.value)|trans,
                                }) }}
                            </p>
                        {% endif %}

                        {# ── La Crue (FOY-08) ────────────────────────────── #}
                        {# Le foyer merite un rang que le quota lui refuse. La   #}
                        {# competition doit se voir et nommer qui occupe la      #}
                        {# place : une attente muette est vecue comme un bug.    #}
                        {% if settlement.crue %}
                            <p class="ds-hint mt-1">
                                {{ 'game.zone.settlement.crue.waiting'|trans({
                                    '%rank%': ('game.settlement.rank.' ~ settlement.crue.rank.value)|trans,
                                    '%quota%': settlement.crue.quota,
                                }) }}
                                {% if settlement.crue.occupants is not empty %}
                                    {{ 'game.zone.settlement.crue.held_by'|trans }}
                                    {%- for occupant in settlement.crue.occupants %}
                                        {{ occupant }}{{ not loop.last ? ',' : '' }}
                                    {%- endfor %}
                                {% endif %}
                            </p>
                        {% endif %}

                        {# ── Ateliers de doctrine (FOY-13) ───────────────── #}
                        {# L'axe Extraire / Preserver devient un batiment. Les  #}
                        {# deux ateliers s'affichent toujours, meme quand un    #}
                        {# seul est adoptable : l'axe ne se comprend qu'en      #}
                        {# voyant ce qu'on n'a pas choisi.                      #}
                        {% if doctrines is not empty %}
                            <div class="ds-divider my-2"></div>
                            <p class="ds-label">{{ 'game.zone.doctrine.heading'|trans }}</p>
                            <div class="flex flex-wrap gap-2 mt-1">
                                {% for offer in doctrines %}
                                    <div class="ds-card p-2 flex-1 min-w-[9rem] {{ offer.adopted ? '' : 'opacity-80' }}">
                                        <p class="text-xs font-semibold text-ink">
                                            {{ ('game.settlement.doctrine.' ~ offer.doctrine.value ~ '.name')|trans }}
                                        </p>
                                        <p class="ds-hint">
                                            {{ ('game.settlement.doctrine.' ~ offer.doctrine.value ~ '.effect')|trans }}
                                        </p>
                                        {% if offer.adopted %}
                                            <p class="ds-hint mt-1">
                                                ⚑ {{ 'game.zone.doctrine.in_place'|trans }}
                                                {% if offer.lockedUntil %}
                                                    {{ 'game.zone.doctrine.locked_until'|trans({'%date%': offer.lockedUntil|date('d/m')}) }}
                                                {% endif %}
                                            </p>
                                        {% elseif offer.canAdopt %}
                                            <form method="post" action="{{ path('app_game_zone_doctrine', {doctrine: offer.doctrine.value}) }}" class="mt-1.5" data-testid="zone-doctrine-form">
                                                <input type="hidden" name="_token" value="{{ csrf_token('doctrine_' ~ offer.doctrine.value) }}">
                                                <button type="submit" data-testid="zone-doctrine-button"
                                                        class="ds-btn ds-btn--quiet ds-btn--sm w-full">
                                                    {{ 'game.zone.doctrine.adopt'|trans({'%cost%': offer.cost}) }}
                                                </button>
                                            </form>
                                        {% else %}
                                            <p class="ds-hint mt-1">{{ offer.blockedReason|trans }}</p>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}

                        {# ── Chantier de la semaine (RET-05) ─────────────── #}
                        {# La maree dit ou va la ville ; le chantier dit ce      #}
                        {# qu'elle attend cette semaine. Les contributeurs sont  #}
                        {# nommes : un chantier rempli doit dire qui l'a rempli. #}
                        {% if settlement.work %}
                            <div class="ds-divider my-2"></div>
                            <p class="ds-label">{{ 'game.zone.settlement.work.heading'|trans }}</p>

                            {% for need in settlement.work.needs %}
                                <div class="flex items-baseline justify-between gap-2 mt-1">
                                    <span class="text-xs text-ink-soft">
                                        {{ ('game.settlement.work.need.' ~ need.activity)|trans }}
                                    </span>
                                    <span class="ds-num ds-num--sm ds-num--muted">
                                        {{ need.progress }}/{{ need.target }}
                                    </span>
                                </div>
                            {% endfor %}

                            <div class="ds-meter mt-2">
                                <div class="ds-meter__fill {{ settlement.work.complete ? 'ds-meter__fill--gain' : '' }}"
                                     style="width: {{ settlement.work.percent }}%"></div>
                            </div>

                            {% if settlement.work.complete %}
                                <p class="ds-hint mt-1">{{ 'game.zone.settlement.work.complete'|trans }}</p>
                            {% endif %}

                            {% if settlement.work.contributors is not empty %}
                                <p class="ds-hint mt-1">
                                    {{ 'game.zone.settlement.work.thanks'|trans }}
                                    {%- for contributor in settlement.work.contributors %}
                                        {{ contributor.name }} ({{ contributor.units }}){{ not loop.last ? ',' : '' }}
                                    {%- endfor %}
                                </p>
                            {% endif %}
                        {% endif %}

                        {# ── Ce que le rang ouvre (FOY-06) ───────────────── #}
                        {# Les services fermes restent visibles avec leur rang  #}
                        {# manquant : c'est ce qui transforme un chiffre qui    #}
                        {# monte en projet. Aucun d'eux ne ferme un ecran       #}
                        {# existant — le HV et la banque restent joignables par #}
                        {# le menu, quel que soit le rang (decision A).         #}
                        {% if settlement.services is not empty %}
                            <div class="ds-divider my-2"></div>
                            <p class="ds-label">{{ 'game.zone.settlement.services'|trans }}</p>
                            <div class="mt-1 space-y-1">
                                {% for service in settlement.services %}
                                    {% if service.open %}
                                        <a href="{{ path(service.route) }}" class="ds-btn ds-btn--secondary ds-btn--sm w-full">
                                            {{ ('game.settlement.service.' ~ service.service)|trans }}
                                        </a>
                                    {% else %}
                                        <p class="ds-hint">
                                            {{ 'game.zone.settlement.service_locked'|trans({
                                                '%service%': ('game.settlement.service.' ~ service.service)|trans,
                                                '%required%': ('game.settlement.rank.' ~ service.required.value)|trans,
                                            }) }}
                                        </p>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        {% endif %}

                        <div class="ds-divider my-2"></div>

                        {% for row in settlement.indices %}
                            <div class="flex items-baseline justify-between gap-2">
                                <span class="text-xs text-ink-soft">{{ ('game.settlement.index.' ~ row.index.value)|trans }}</span>
                                <span class="ds-num ds-num--sm ds-num--muted">{{ row.value }}</span>
                            </div>
                        {% endfor %}

                        <div class="ds-divider my-2"></div>

                        <div class="flex items-baseline justify-between gap-2">
                            <span class="text-xs text-ink-soft">{{ 'game.zone.settlement.your_share'|trans }}</span>
                            <span class="ds-num ds-num--sm">{{ settlement.contribution }}</span>
                        </div>
                        {% if settlement.guildContribution > 0 %}
                            <div class="flex items-baseline justify-between gap-2">
                                <span class="text-xs text-ink-soft">{{ 'game.zone.settlement.guild_share'|trans }}</span>
                                <span class="ds-num ds-num--sm">{{ settlement.guildContribution }}</span>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}

                {# ── Expedition time-gated (ZON-13) ──────────────── #}
                {% if expedition %}
                    {% if expedition.active %}
                        <div class="ds-card p-3 mb-4">
                            {% if expedition.ready %}
                                <p class="text-sm font-semibold text-ink">
                                    🧭 {{ 'game.zone.expedition.ready'|trans({'%zone%': expedition.zone.localizedName(app.request.locale)}) }}
                                </p>
                                <form method="post" action="{{ path('app_game_zone_expedition_claim') }}" class="mt-2">
                                    <input type="hidden" name="_token" value="{{ csrf_token('expedition_claim') }}">
                                    <button type="submit" class="ds-btn ds-btn--secondary ds-btn--sm">
                                        {{ 'game.zone.expedition.claim'|trans }}
                                    </button>
                                </form>
                            {% else %}
                                <p class="text-sm font-semibold text-ink">
                                    🧭 {{ 'game.zone.expedition.in_progress'|trans({'%zone%': expedition.zone.localizedName(app.request.locale)}) }}
                                </p>
                                <p class="ds-num ds-num--sm ds-num--muted text-left mt-0.5">
                                    {% if expedition.remainingSeconds < 60 %}
                                        {{ 'game.zone.expedition.return_imminent'|trans }}
                                    {% else %}
                                        {{ 'game.zone.expedition.return_in'|trans({'%minutes%': (expedition.remainingSeconds / 60)|round(0, 'ceil')}) }}
                                    {% endif %}
                                </p>
                            {% endif %}
                        </div>
                    {% elseif expedition.eligible and not travel %}
                        <div class="ds-card p-3 mb-4">
                            <p class="ds-label">{{ 'game.zone.expedition.heading'|trans }}</p>
                            <p class="ds-hint mt-0.5 mb-2">{{ 'game.zone.expedition.subtitle'|trans }}</p>
                            <div class="flex flex-wrap gap-2">
                                {% for key, seconds in expedition.durations %}
                                    <form method="post" action="{{ path('app_game_zone_expedition_start', {durationKey: key}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('expedition_start_' ~ key) }}">
                                        <button type="submit" class="ds-btn ds-btn--secondary ds-btn--sm">
                                            {{ ('game.zone.expedition.duration.' ~ key)|trans }}
                                            <span class="ds-num ds-num--sm ds-num--muted">{{ (seconds / 3600)|round(1) }} h</span>
                                        </button>
                                    </form>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                {% endif %}

                {# ── Evenements de zone (ZON-15) ─────────────────── #}
                {% if zoneEvents is not empty %}
                    <div class="mb-4 space-y-2">
                        {% for event in zoneEvents %}
                            <div class="ds-card ds-edge-amethyst p-3">
                                <div class="flex flex-wrap items-center justify-between gap-2">
                                    <div>
                                        <p class="ds-name ds-name--sm">⚔️ {{ event.name }}
                                            <span class="ds-seal ds-seal-amethyst ml-1">{{ event.typeLabel }}</span>
                                        </p>
                                        <p class="ds-num ds-num--sm ds-num--muted text-left mt-0.5">
                                            {% if event.remainingSeconds < 60 %}
                                                {{ 'game.zone.event.ends_imminent'|trans }}
                                            {% else %}
                                                {{ 'game.zone.event.ends_in'|trans({'%minutes%': (event.remainingSeconds / 60)|round(0, 'ceil')}) }}
                                            {% endif %}
                                        </p>
                                    </div>
                                    {% if event.joined %}
                                        <span class="ds-seal ds-seal--gain">
                                            {{ 'game.zone.event.joined'|trans }}
                                        </span>
                                    {% else %}
                                        <form method="post" action="{{ path('app_game_zone_event_join', {id: event.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('zone_event_join_' ~ event.id) }}">
                                            <button type="submit" class="ds-btn ds-btn--secondary ds-btn--sm">
                                                {{ 'game.zone.event.join'|trans }}
                                                <span class="ds-num ds-num--sm ds-num--muted">⚡ {{ event.cost }}</span>
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {# ── Boss de zone asynchrone (ZON-18) ────────────── #}
                {% if zoneBoss %}
                    <div class="ds-card ds-edge-amethyst p-3 mb-4">
                        <div class="flex items-center justify-between gap-2 mb-1.5">
                            <p class="ds-name ds-name--sm">☠️ {{ zoneBoss.name }}
                                <span class="ds-seal ds-seal-amethyst ml-1">{{ zoneBoss.eventName }}</span>
                            </p>
                            <span class="ds-num">{{ zoneBoss.hpCurrent }} / {{ zoneBoss.hpMax }} PV</span>
                        </div>
                        <div class="ds-meter ds-meter--tall mb-2">
                            <div class="ds-meter__fill ds-meter__fill--hp" style="width: {{ zoneBoss.hpPercent }}%"></div>
                        </div>
                        <form method="post" action="{{ path('app_game_zone_boss_assault', {id: zoneBoss.eventId}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('zone_boss_assault_' ~ zoneBoss.eventId) }}">
                            <button type="submit" class="ds-btn ds-btn--secondary ds-btn--sm">
                                {{ 'game.zone.boss.assault'|trans }}
                                <span class="ds-num ds-num--sm ds-num--muted">⚡ {{ zoneBoss.cost }}</span>
                            </button>
                        </form>
                        <p class="ds-hint mt-1.5">{{ 'game.zone.boss.hint'|trans }}</p>
                    </div>
                {% endif %}

                {# ── Donjon de groupe semi-synchrone (ZON-19) ────── #}
                {% if groupDungeon %}
                    <div class="ds-card ds-edge-rare p-3 mb-4"
                         data-controller="group-dungeon"
                         data-group-dungeon-mercure-url-value="{{ (mercure_url is defined and mercure_url starts with 'http') ? mercure_url : (app.request.schemeAndHttpHost ~ '/.well-known/mercure') }}"
                         data-group-dungeon-run-id-value="{{ groupDungeon.runId }}"
                         data-group-dungeon-player-id-value="{{ groupDungeon.viewerId }}"
                         data-group-dungeon-turn-label-value="{{ 'game.zone.dungeon.turn_in'|trans({'%seconds%': '{s}'}) }}">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <p class="ds-name ds-name--sm">
                                🛡️ {{ 'game.zone.dungeon.in_progress'|trans({'%dungeon%': groupDungeon.dungeonName, '%count%': groupDungeon.memberCount}) }}
                            </p>
                            {% if groupDungeon.isLeader %}
                                <form method="post" action="{{ path('app_game_zone_dungeon_abandon') }}"
                                      data-group-dungeon-target="abandon"
                                      {{ groupDungeon.combat.status == 'completed' ? 'class=hidden' : '' }}>
                                    <input type="hidden" name="_token" value="{{ csrf_token('group_dungeon_abandon') }}">
                                    <button type="submit" class="ds-btn ds-btn--quiet ds-btn--sm text-loss">
                                        {{ 'game.zone.dungeon.abandon'|trans }}
                                    </button>
                                </form>
                            {% endif %}
                        </div>

                        <p class="text-sm text-gain mt-1.5 {{ groupDungeon.combat.status == 'completed' ? '' : 'hidden' }}"
                           data-group-dungeon-target="cleared">🏆 {{ 'game.zone.dungeon.cleared'|trans }}{% if groupDungeon.rewardGils is not null %} <span class="ds-num ds-num--gain">+{{ groupDungeon.rewardGils }} gils</span>{% endif %}</p>

                        <div data-group-dungeon-target="combat" class="{{ groupDungeon.combat.status == 'completed' ? 'hidden' : '' }}">
                            {# DON-03 : l'etape et la creature — plus une barre anonyme. #}
                            <p class="ds-hint mt-2" data-group-dungeon-target="encounter"
                               data-step-template="{{ 'game.zone.dungeon.step'|trans({'%step%': '%step%', '%total%': '%total%'}) }}">
                                {{- 'game.zone.dungeon.step'|trans({'%step%': groupDungeon.combat.currentStep, '%total%': groupDungeon.combat.totalSteps}) }}{% if groupDungeon.combat.encounterName %} · {{ groupDungeon.combat.encounterName }}{% endif -%}
                            </p>
                            <div class="ds-meter mt-2 mb-1">
                                <div class="ds-meter__fill ds-meter__fill--hp" style="width: {{ groupDungeon.combat.encounterHpPercent }}%"
                                     data-group-dungeon-target="hpBar"></div>
                            </div>
                            <div class="flex items-center justify-between gap-2">
                                <span class="ds-num ds-num--sm ds-num--muted">
                                    <span data-group-dungeon-target="hpText">{{ groupDungeon.combat.encounterHpCurrent }} / {{ groupDungeon.combat.encounterHpMax }} PV</span>
                                    <span data-group-dungeon-target="turn">{% if groupDungeon.combat.turnRemainingSeconds is not null %}· {{ 'game.zone.dungeon.turn_in'|trans({'%seconds%': groupDungeon.combat.turnRemainingSeconds}) }}{% endif %}</span>
                                </span>
                                <form method="post" action="{{ path('app_game_zone_dungeon_act') }}"
                                      data-group-dungeon-target="attack"
                                      {{ groupDungeon.isMyTurn ? '' : 'class=hidden' }}>
                                    <input type="hidden" name="_token" value="{{ csrf_token('group_dungeon_act') }}">
                                    <button type="submit" class="ds-btn ds-btn--secondary ds-btn--sm">
                                        {{ 'game.zone.dungeon.attack'|trans }}
                                    </button>
                                </form>
                                <span class="ds-hint {{ groupDungeon.isMyTurn ? 'hidden' : '' }}"
                                      data-group-dungeon-target="waiting">{{ 'game.zone.dungeon.waiting_turn'|trans }}</span>
                            </div>
                        </div>
                        <p class="ds-hint mt-1.5">{{ 'game.zone.dungeon.semisync_hint'|trans }}</p>
                    </div>
                {% endif %}

                {# ── Donjons de groupe proposes par la zone ───────── #}
                {% if groupDungeonOffers is not empty %}
                    <div class="mb-4" data-testid="zone-group-dungeons">
                        <h4 class="ds-label mb-2">🛡️ {{ 'game.zone.dungeon.offers_title'|trans }}</h4>
                        <ul class="space-y-1.5">
                            {% for offer in groupDungeonOffers %}
                                <li class="ds-row">
                                    <span class="ds-row__body">
                                        <span class="ds-row__name ds-name--sm">{{ offer.dungeon|localized_dungeon_name }}</span>
                                        <span class="ds-row__meta">
                                            {{ 'game.zone.dungeon.offer_group_size'|trans({'%max%': offer.maxPlayers}) }}
                                            {%- if offer.requiredExperience > 0 %} · {{ 'game.zone.dungeon.offer_required_xp'|trans({'%xp%': offer.requiredExperience}) }}{% endif %}
                                            {#- DON-04 : l'apercu derive de la table reelle — materia au palier du donjon, gils decroissants. -#}
                                            {%- if offer.lootMateria %} · {{ 'game.zone.dungeon.loot_materia'|trans({'%paliers%': offer.lootMateria}) }} · {{ 'game.zone.dungeon.loot_gils'|trans }}{% endif %}
                                        </span>
                                    </span>
                                    {# Action secondaire : « Explorer » reste la seule action primaire de l'ecran. #}
                                    {% if offer.canLaunch %}
                                        <form method="post" action="{{ path('app_game_zone_dungeon_launch', {'id': offer.id}) }}" class="shrink-0 ml-3">
                                            <input type="hidden" name="_token" value="{{ csrf_token('group_dungeon_launch_' ~ offer.id) }}">
                                            <button type="submit" class="ds-btn ds-btn--secondary ds-btn--sm">
                                                {{ 'game.zone.dungeon.launch'|trans }}
                                            </button>
                                        </form>
                                    {% else %}
                                        <span class="ds-hint shrink-0 ml-3 text-right">{{ offer.blocker|trans }}</span>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                        <p class="ds-hint mt-1.5">{{ 'game.zone.dungeon.offers_hint'|trans }}</p>
                    </div>
                {% endif %}

                {# ── En-tete de zone ─────────────────────────────── #}
                <div class="mb-4" data-testid="zone-header">
                    <div class="flex flex-wrap items-center gap-2">
                        <h3 class="ds-title" data-testid="zone-name">{{ zone.localizedName(app.request.locale) }}</h3>
                        <span class="ds-seal ds-seal-common">
                            {{ (typeLabels[zone.type] ?? 'game.zone.type.wilderness')|trans }}
                        </span>
                        {% if zone.isSafe %}
                            <span class="ds-seal ds-seal--gain">
                                {{ 'game.zone.safe_badge'|trans }}
                            </span>
                        {% endif %}
                    </div>
                    {% set description = zone.localizedDescription(app.request.locale) %}
                    {% if description %}
                        <p class="ds-body mt-2">{{ description }}</p>
                    {% endif %}
                    {# ZON-41 — le bandeau est purement decoratif : le nom de la zone
                       est deja en titre deux lignes au-dessus, et un `alt` qui le
                       repete le fait annoncer deux fois par un lecteur d'ecran.
                       Meme traitement que la carte du monde. Les dimensions
                       explicites evitent que l'image pousse la page en cours de
                       chargement. #}
                    {% if zone.illustrationPath %}
                        <img src="{{ asset('images/' ~ zone.illustrationPath) }}" alt="" aria-hidden="true"
                             width="1024" height="384" loading="lazy" decoding="async"
                             class="mt-3 rounded-panel border border-line max-h-48 w-full object-cover">
                    {% endif %}
                </div>

                {# ── Echoppes joueur (ECO-12) ────────────────────── #}
                {% if shopsPresent|default([])|length > 0 %}
                    <div class="mb-4" data-testid="zone-shops">
                        <h4 class="ds-label mb-2">Echoppes</h4>
                        <ul class="space-y-1.5">
                            {% for playerShop in shopsPresent %}
                                <li class="ds-row">
                                    <span class="ds-row__body">
                                        <span class="ds-row__name ds-name--sm">{{ playerShop.name }}</span>
                                        <span class="ds-row__meta">{{ playerShop.owner.name }}</span>
                                    </span>
                                    <a href="{{ path('app_game_player_shop_visit', {id: playerShop.id}) }}"
                                       data-testid="zone-player-shop-link"
                                       class="ds-btn ds-btn--secondary ds-btn--sm">
                                        Entrer
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                {# ── PNJ presents (ZON-27) ───────────────────────── #}
                <div class="mb-4" data-testid="zone-pnjs">
                    <h4 class="ds-label mb-2">{{ 'game.zone.pnjs.heading'|trans }}</h4>
                    {% if pnjsPresent is empty %}
                        <div class="ds-empty">
                            <p class="ds-empty__hint">{{ 'game.zone.pnjs.empty'|trans }}</p>
                        </div>
                    {% else %}
                        <ul class="space-y-1.5">
                            {% for pnj in pnjsPresent %}
                                <li class="ds-row">
                                    <span class="ds-row__body">
                                        <span class="ds-row__name ds-name--sm">{{ pnj.localizedName(app.request.locale) }}</span>
                                    </span>
                                    <span class="flex items-center gap-2">
                                    {% if pnj.dialog is not empty %}
                                        <a href="{{ path('app_game_pnj_talk', {id: pnj.id}) }}"
                                           data-testid="zone-pnj-talk-link"
                                           class="ds-btn ds-btn--secondary ds-btn--sm">
                                            {{ 'game.zone.pnjs.talk'|trans }}
                                        </a>
                                    {% endif %}
                                    {% if pnj.isMerchant %}
                                        {% if pnj.isShopOpen(gameHour) %}
                                            <a href="{{ path('app_game_shop', {id: pnj.id}) }}"
                                               data-testid="zone-pnj-shop-link"
                                               class="ds-btn ds-btn--secondary ds-btn--sm">
                                                {{ 'game.zone.pnjs.shop'|trans }}
                                            </a>
                                        {% else %}
                                            <span class="ds-btn ds-btn--disabled ds-btn--sm">
                                                {{ 'game.zone.pnjs.shop_closed'|trans }}
                                            </span>
                                        {% endif %}
                                    {% endif %}
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>

                {# ── Actions de zone (ZON-08..10) ────────────────── #}
                {% if actions is not empty %}
                    <div class="mb-4">
                        <h4 class="ds-label mb-2">{{ 'game.zone.actions.heading'|trans }}</h4>
                        <div class="flex flex-wrap gap-2">
                            {% for action in actions %}
                                {% if action.key == 'explore' and action.enabled %}
                                    {# L'unique action primaire de l'ecran. #}
                                    <form method="post" action="{{ path('app_game_zone_explore') }}" data-testid="zone-explore-form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('explore') }}">
                                        <button type="submit" data-testid="zone-explore-button"
                                                {% if travel %}disabled title="{{ 'game.zone.travel.error.already_traveling'|trans }}"{% endif %}
                                                class="ds-btn ds-btn--primary">
                                            {{ action.label|trans }}
                                            <span class="ds-num ds-num--sm">⚡ {{ action.cost }}</span>
                                        </button>
                                    </form>
                                {% endif %}
                                {# 'hunt' (ZON-09) et 'gather' (ZON-10) ont leur bloc dedie ci-dessous #}
                            {% endfor %}
                        </div>
                    </div>

                    {# ── Chasser : proies ciblees du bestiaire (ZON-09) ── #}
                    {% if not zone.isSafe %}
                        <div class="mb-4">
                            <h4 class="ds-label mb-2">{{ 'game.zone.hunt.heading'|trans }}</h4>
                            {% if huntTargets is empty %}
                                <div class="ds-empty">
                                    <p class="ds-empty__hint">{{ 'game.zone.hunt.empty'|trans }}</p>
                                </div>
                            {% else %}
                                <div class="flex flex-wrap gap-2">
                                    {% for target in huntTargets %}
                                        <form method="post" action="{{ path('app_game_zone_hunt', {id: target.id}) }}" data-testid="zone-hunt-form">
                                            <input type="hidden" name="_token" value="{{ csrf_token('hunt_' ~ target.id) }}">
                                            <button type="submit" data-testid="zone-hunt-button"
                                                    {% if travel %}disabled title="{{ 'game.zone.travel.error.already_traveling'|trans }}"{% endif %}
                                                    class="ds-btn ds-btn--secondary">
                                                🎯 {{ target.localizedName(app.request.locale) }}
                                                <span class="ds-num ds-num--sm ds-num--muted">⚡ {{ huntCost }}</span>
                                            </button>
                                        </form>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}

                    {# ── Recolter : filons partages de la zone (ZON-10) ── #}
                    {% if gatherables is not empty %}
                        {% set professionIcons = {'mining': '⛏️', 'herbalism': '🌿', 'fishing': '🎣', 'woodcutting': '🪓'} %}
                        <div class="mb-4">
                            <h4 class="ds-label mb-2">{{ 'game.zone.gather.heading'|trans }}</h4>
                            <div class="flex flex-wrap gap-2">
                                {% for gatherable in gatherables %}
                                    {% set depleted = gatherable.depleted %}
                                    <div class="ds-card p-3 min-w-[10rem] {{ depleted ? 'opacity-70' : '' }}">
                                        <div class="flex items-center justify-between gap-2">
                                            <span class="text-sm font-semibold text-ink">
                                                {{ professionIcons[gatherable.profession] ?? '🧺' }} {{ gatherable.itemName }}
                                            </span>
                                            <span class="ds-num ds-num--sm ds-num--muted">⚡ {{ gatherCost }}</span>
                                        </div>
                                        {# Le stock est collectif : c'est une information sociale, pas un compteur perso. #}
                                        <div class="mt-1.5 flex items-center gap-2">
                                            <div class="ds-meter flex-1">
                                                <div class="ds-meter__fill {{ depleted ? '' : 'ds-meter__fill--gain' }}" style="width: {{ gatherable.capacity > 0 ? ((gatherable.stock / gatherable.capacity) * 100)|round : 0 }}%"></div>
                                            </div>
                                            <span class="ds-num ds-num--sm">{{ gatherable.stock }}/{{ gatherable.capacity }}</span>
                                        </div>
                                        {# ECO-22 — information exclusive du prospecteur. Elle ne #}
                                        {# donne ni energie, ni action, ni butin : elle donne de   #}
                                        {# la decision. Absente pour qui n'a pas travaille son     #}
                                        {# arbre de recolte, et pour les matieres fongibles.       #}
                                        {% if gatherable.purityCeiling %}
                                            <p class="ds-hint mt-1">
                                                {{ 'game.zone.gather.purity_ceiling'|trans }}
                                                <span class="ds-seal {{ gatherable.purityCeiling.sealClass }}">
                                                    {{ ('game.purity.band.' ~ gatherable.purityCeiling.value)|trans }}
                                                </span>
                                            </p>
                                        {% endif %}
                                        {# FOY-11 — la Paleur se voit, et dit quoi faire. Le  #}
                                        {# message n'accuse personne et ne demande a personne #}
                                        {# de s'abstenir : le filon se refait pendant qu'on   #}
                                        {# joue, simplement plus lentement qu'il ne s'abime.  #}
                                        {% if gatherable.isPale(palenessVisibleFrom) %}
                                            <p class="ds-hint mt-1">
                                                🌫️ {{ 'game.zone.gather.paleness'|trans({'%percent%': gatherable.palenessPercent}) }}
                                            </p>
                                        {% endif %}
                                        {# FOY-12 — la restauration est un acte de gouvernement : #}
                                        {# son prix se lit meme sans guilde, et la raison d'un    #}
                                        {# bouton absent se dit plutot que de laisser un blanc.   #}
                                        {% set restoration = restorations[gatherable.slug] ?? null %}
                                        {% if restoration %}
                                            {% if restoration.isUnderway %}
                                                <p class="ds-hint mt-1">
                                                    🛠️ {{ 'game.zone.restoration.underway'|trans({
                                                        '%guild%': restoration.activeGuildName,
                                                        '%date%': restoration.activeUntil|date('d/m'),
                                                    }) }}
                                                </p>
                                            {% elseif restoration.canOpen %}
                                                <form method="post" action="{{ path('app_game_zone_restore', {slug: gatherable.slug}) }}" class="mt-1.5" data-testid="zone-restore-form">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('restore_' ~ gatherable.slug) }}">
                                                    <button type="submit" data-testid="zone-restore-button"
                                                            class="ds-btn ds-btn--ghost ds-btn--sm w-full">
                                                        🛠️ {{ 'game.zone.restoration.open'|trans({'%cost%': restoration.cost}) }}
                                                    </button>
                                                </form>
                                            {% else %}
                                                <p class="ds-hint mt-1">
                                                    🛠️ {{ 'game.zone.restoration.quote'|trans({'%cost%': restoration.cost}) }}
                                                    — {{ restoration.blockedReason|trans }}
                                                </p>
                                            {% endif %}
                                        {% endif %}
                                        {# ECO-24c — le filon gate reste visible, et dit ce   #}
                                        {# qu'il demande. Le cacher aurait retire au joueur   #}
                                        {# la seule raison d'aller chercher la competence.    #}
                                        {% if gatherable.locked %}
                                            <p class="ds-hint mt-1">
                                                🔒 {{ 'game.zone.gather.locked_by'|trans }} {{ gatherable.lockedBy }}
                                            </p>
                                        {% elseif depleted %}
                                            <p class="ds-num ds-num--sm ds-num--muted text-left mt-1">
                                                {% if gatherable.respawnRemaining > 0 %}
                                                    {{ 'game.zone.gather.respawn_in'|trans({'%minutes%': (gatherable.respawnRemaining / 60)|round(0, 'ceil')}) }}
                                                {% else %}
                                                    {{ 'game.zone.gather.depleted'|trans }}
                                                {% endif %}
                                            </p>
                                        {% else %}
                                            <form method="post" action="{{ path('app_game_zone_gather', {slug: gatherable.slug}) }}" class="mt-1.5" data-testid="zone-gather-form">
                                                <input type="hidden" name="_token" value="{{ csrf_token('gather_' ~ gatherable.slug) }}">
                                                <button type="submit" data-testid="zone-gather-button"
                                                        {% if travel %}disabled title="{{ 'game.zone.travel.error.already_traveling'|trans }}"{% endif %}
                                                        class="ds-btn ds-btn--secondary ds-btn--sm w-full">
                                                    {{ 'game.zone.actions.gather'|trans }}
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                {% endif %}

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {# ── Connexions ──────────────────────────────── #}
                    <div>
                        <h4 class="ds-label mb-2">{{ 'game.zone.connections.heading'|trans }}</h4>
                        {# ONB-10 — la faveur s'annonce avant le depart. Un trajet
                           de dix minutes qui n'en prend aucune, non annonce, se lit
                           comme un bug et non comme un cadeau. #}
                        {% if firstTravelOffered|default(false) %}
                            <p class="ds-hint mb-2">{{ 'game.zone.connections.first_travel_offered'|trans }}</p>
                        {% endif %}
                        {% if connections is empty %}
                            <div class="ds-empty">
                                <p class="ds-empty__hint">{{ 'game.zone.connections.empty'|trans }}</p>
                            </div>
                        {% else %}
                            <ul class="space-y-1.5">
                                {% set isGameMaster = isGameMaster|default(false) %}
                                {% for row in connections %}
                                    {% set connection = row.connection %}
                                    {% set seconds = row.seconds %}
                                    {# Un MJ voyage sans decouverte prealable : rien ne lui est verrouille. #}
                                    {% set locked = not isGameMaster and connection.requiresDiscovery and connection.toZone.id not in visitedZoneIds %}
                                    <li class="ds-row">
                                        <span class="ds-row__body">
                                            <span class="ds-row__name ds-name--sm">
                                                {{ connection.toZone.localizedName(app.request.locale) }}
                                                {% if locked %}
                                                    <span title="{{ 'game.zone.connections.locked'|trans }}">🔒</span>
                                                {% endif %}
                                                {% if row.disabled|default(false) %}
                                                    <span class="ds-seal ds-seal--loss" title="{{ 'game.zone.connections.gm_disabled'|trans }}">{{ 'game.zone.connections.gm_disabled_short'|trans }}</span>
                                                {% endif %}
                                            </span>
                                            {# Duree reelle, mono : elle vient des `connections` declarees. #}
                                            <span class="ds-num ds-num--sm text-left {{ seconds < connection.travelSeconds ? 'ds-num--gain' : 'ds-num--muted' }}">
                                                {% if seconds == 0 %}
                                                    {{ 'game.zone.connections.travel_instant'|trans }}
                                                {% else %}
                                                    {{ 'game.zone.connections.travel_minutes'|trans({'%count%': (seconds / 60)|round}) }}
                                                {% endif %}
                                                {% if not isGameMaster and seconds < connection.travelSeconds %}
                                                    <span title="{{ 'game.zone.connections.travel_mounted'|trans({'%mount%': mount|localized_mount_name, '%base%': (connection.travelSeconds / 60)|round}) }}">🐎</span>
                                                {% endif %}
                                            </span>
                                        </span>
                                        {% if locked %}
                                            <span class="ds-btn ds-btn--disabled ds-btn--sm">
                                                {{ 'game.zone.travel.button'|trans }}
                                            </span>
                                        {% elseif travel %}
                                            <span class="ds-btn ds-btn--disabled ds-btn--sm"
                                                  title="{{ 'game.zone.travel.error.already_traveling'|trans }}">
                                                {{ 'game.zone.travel.button'|trans }}
                                            </span>
                                        {% else %}
                                            <form method="post" action="{{ path('app_game_zone_travel', {id: connection.id}) }}" data-testid="zone-travel-form">
                                                <input type="hidden" name="_token" value="{{ csrf_token('travel_' ~ connection.id) }}">
                                                <button type="submit" data-testid="zone-travel-button"
                                                        class="ds-btn ds-btn--secondary ds-btn--sm">
                                                    {{ 'game.zone.travel.button'|trans }}
                                                </button>
                                            </form>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>

                    {# ── Presence & chat de zone (ZON-14) ────────── #}
                    <div {% if zoneChat %}data-controller="zone-chat"
                         data-zone-chat-mercure-url-value="{{ (mercure_url is defined and mercure_url starts with 'http') ? mercure_url : (app.request.schemeAndHttpHost ~ '/.well-known/mercure') }}"
                         data-zone-chat-zone-id-value="{{ zoneChat.zoneId }}"
                         data-zone-chat-send-url-value="{{ path('app_game_chat_send') }}"
                         data-zone-chat-presence-url-value="{{ path('app_game_zone_presence') }}"
                         data-zone-chat-invite-url-value="{{ path('app_game_party_invite', {playerId: '__ID__'}) }}"
                         data-zone-chat-profile-url-value="{{ path('app_game_player_profile', {id: '__ID__'}) }}"{% endif %}>
                        <h4 class="ds-label mb-2">{{ 'game.zone.players.heading'|trans }}</h4>
                        <div data-zone-chat-target="presence" class="space-y-1">
                            {% if playersPresent is empty %}
                                <div class="ds-empty">
                                    <p class="ds-empty__hint">{{ 'game.zone.players.empty'|trans }}</p>
                                </div>
                            {% else %}
                                {% for presentPlayer in playersPresent %}
                                    <div class="ds-row min-h-0 py-1.5">
                                        <a href="{{ path('app_game_player_profile', {id: presentPlayer.id}) }}" class="ds-row__body ds-row__name ds-name--sm truncate">
                                            {{ include('components/_game_master_seal.html.twig', {player: presentPlayer, compact: true}, with_context = false) }}
                                            {{ presentPlayer.name }}
                                        </a>
                                        {% if app.user and presentPlayer.user is defined and presentPlayer.user == app.user %}
                                            <span class="ds-seal ds-seal-epic">{{ 'game.zone.players.you'|trans }}</span>
                                        {% else %}
                                            <form method="post" action="{{ path('app_game_party_invite', {playerId: presentPlayer.id}) }}">
                                                <button type="submit" class="ds-btn ds-btn--quiet ds-btn--sm" title="{{ 'game.zone.players.invite'|trans }}">+</button>
                                            </form>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            {% endif %}
                        </div>

                        {# ── Chat de zone (temps reel Mercure) ────── #}
                        {% if zoneChat %}
                            <h4 class="ds-label mb-2 mt-4">{{ 'game.zone.chat.heading'|trans }}</h4>
                            <div class="ds-card">
                                <div data-zone-chat-target="messages" class="h-40 overflow-y-auto px-3 py-2 text-xs">
                                    {% for message in zoneChat.messages %}
                                        <div class="text-xs py-0.5">
                                            <span class="ds-num ds-num--sm ds-num--muted mr-1">{{ message.createdAt ? message.createdAt|date('H:i') : '' }}</span>
                                            {{ include('components/_game_master_seal.html.twig', {player: message.sender, compact: true}, with_context = false) }}
                                            <span class="font-semibold text-brand mr-1">{{ message.sender.name }}:</span>
                                            <span class="text-ink">{{ message.content }}</span>
                                        </div>
                                    {% endfor %}
                                </div>
                                <form data-action="zone-chat#send" class="flex gap-1 border-t border-line p-2">
                                    <input data-zone-chat-target="input" type="text" maxlength="500"
                                           placeholder="{{ 'game.zone.chat.placeholder'|trans }}"
                                           class="flex-1 rounded-card bg-paper border border-line px-2 py-1 text-xs text-ink focus:outline-hidden focus:border-brand">
                                    <button type="submit" class="ds-btn ds-btn--secondary ds-btn--sm">{{ 'game.zone.chat.send'|trans }}</button>
                                </form>
                            </div>
                        {% endif %}

                        {# ── Points d'interet ────────────────────── #}
                        <h4 class="ds-label mb-2 mt-4">{{ 'game.zone.poi.heading'|trans }}</h4>
                        {% if poiCounts is empty %}
                            <div class="ds-empty">
                                <p class="ds-empty__hint">{{ 'game.zone.poi.empty'|trans }}</p>
                            </div>
                        {% else %}
                            <ul>
                                {% for type, count in poiCounts %}
                                    <li class="ds-stat">
                                        <span class="ds-stat__label">{{ (poiLabels[type] ?? type)|trans }}</span>
                                        <span class="ds-num">× {{ count }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            {# WIK-03 — le lien contextuel : l'ecran de zone renvoie a sa page
               du wiki. Une regle publique se lit ou l'on joue. #}
            <p class="ds-hint mt-4 text-center">
                <a href="{{ path('app_wiki_page', {section: '03-le-monde', page: 'zones-et-voyage'}) }}" class="underline">
                    {{ 'game.wiki.context.zone'|trans }}
                </a>
            </p>
        </div>
    </div>
</div>
{% endblock %}
