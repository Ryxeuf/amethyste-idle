{# Carte d'une recette verrouillee (niveau de domaine insuffisant) #}
<div class="ds-card p-4 opacity-60 relative">
    {# Indicateur de verrouillage #}
    <div class="absolute top-3 right-3 flex flex-col items-end gap-1">
        <span class="ds-seal ds-seal-legendary">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
            </svg>
            {{ 'game.crafting.rank_short'|trans({'%rank%': recipe.requiredLevel}) }}
        </span>
        {% if recipe.requiredSpecialization %}
            <span class="ds-seal ds-seal-legendary" title="Recette exclusive a la specialisation {{ recipe.requiredSpecialization.label }}">
                {{ recipe.requiredSpecialization.label }}
            </span>
        {% endif %}
    </div>

    {# En-tete #}
    <div class="mb-3 pr-20">
        <h3 class="ds-name">{{ recipe|localized_recipe_name }}</h3>
        {% if recipe.description %}
            <p class="ds-hint mt-1">{{ recipe|localized_recipe_description }}</p>
        {% endif %}
    </div>

    {# Resultat #}
    <div class="mb-3">
        <h4 class="ds-label mb-1">Resultat</h4>
        <span class="ds-name ds-name--sm">
            {{ recipe.result.name }}
            {% if recipe.resultQuantity > 1 %}
                x{{ recipe.resultQuantity }}
            {% endif %}
        </span>
    </div>

    {# Infos #}
    <div class="ds-stat">
        <span class="ds-num ds-num--sm ds-num--muted text-left">Temps : {{ recipe.craftingTime }}s</span>
        <span class="ds-num ds-num--gain">+{{ recipe.xpReward }} XP</span>
    </div>
</div>
