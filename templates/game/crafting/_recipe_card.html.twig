{# Carte d'une recette d'artisanat #}
{% set canCraftRecipe = craftCheck.possible ?? false %}
{% set missingItems = craftCheck.missing ?? [] %}

{# La qualite est une rarete : elle se dit en sceau, comme dans le DS. #}
{% set qualityColors = {
    'normal': 'ds-seal-common',
    'uncommon': 'ds-seal-uncommon',
    'rare': 'ds-seal-rare',
    'epic': 'ds-seal-epic',
    'legendary': 'ds-seal-legendary',
} %}

{% set qualityLabels = {
    'normal': 'Normal',
    'uncommon': 'Peu commun',
    'rare': 'Rare',
    'epic': 'Epique',
    'legendary': 'Legendaire',
} %}

<div class="ds-card p-4 {% if not canCraftRecipe %}opacity-75{% endif %}">
    {# En-tete #}
    <div class="flex items-start justify-between mb-3">
        <div>
            <h3 class="ds-name">{{ recipe|localized_recipe_name }}</h3>
            {% if recipe.description %}
                <p class="ds-hint mt-1">{{ recipe|localized_recipe_description }}</p>
            {% endif %}
        </div>
        <div class="flex items-center gap-2 ml-2">
            {% if recipe.quality %}
                <span class="ds-seal {{ qualityColors[recipe.quality] ?? qualityColors['normal'] }}">
                    {{ qualityLabels[recipe.quality] ?? 'Normal' }}
                </span>
            {% endif %}
            {% if recipe.requiredSpecialization %}
                <span class="ds-seal ds-seal-legendary" title="Recette exclusive a la specialisation {{ recipe.requiredSpecialization.label }}">
                    {{ recipe.requiredSpecialization.label }}
                </span>
            {% endif %}
            {% if recipe.requiredLevel > 1 %}
                <span class="ds-seal ds-seal-common">
                    {{ 'game.crafting.rank_short'|trans({'%rank%': recipe.requiredLevel}) }}
                </span>
            {% endif %}
        </div>
    </div>

    {# Ingredients #}
    <div class="mb-3">
        <h4 class="ds-label mb-2">Ingredients</h4>
        <div class="flex flex-wrap gap-2">
            {% for ingredient in recipe.ingredients %}
                {% set ingredientSlug = ingredient.slug %}
                {% set ingredientQty = ingredient.quantity ?? 1 %}

                {# Verifier si cet ingredient est dans les manquants #}
                {% set isMissing = false %}
                {% set haveCount = ingredientQty %}
                {% for missing in missingItems %}
                    {% if missing.slug == ingredientSlug %}
                        {% set isMissing = true %}
                        {% set haveCount = missing.have %}
                    {% endif %}
                {% endfor %}

                <span class="ds-seal {{ isMissing ? 'ds-seal--loss' : 'ds-seal--gain' }}">
                    {{ ingredientSlug|replace({'_': ' ', '-': ' '})|capitalize }}
                    <span class="ds-num ds-num--sm ml-1">{{ haveCount }}/{{ ingredientQty }}</span>
                </span>
            {% endfor %}
        </div>
    </div>

    {# Resultat #}
    <div class="mb-3">
        <h4 class="ds-label mb-1">Resultat</h4>
        <span class="ds-name ds-name--sm">
            {{ recipe.result.name }}
            {% if recipe.resultQuantity > 1 %}
                x{{ recipe.resultQuantity }}
            {% endif %}
        </span>
    </div>

    {# Informations de craft #}
    <div class="ds-stat mb-3">
        <span class="ds-num ds-num--sm ds-num--muted text-left">Temps : {{ recipe.craftingTime }}s</span>
        <span class="ds-num ds-num--gain">+{{ recipe.xpReward }} XP</span>
    </div>

    {# Bouton de fabrication avec quantite #}
    {% set maxCraftQty = maxCraft|default(0) %}
    <div {{ stimulus_controller('craft-queue', {
            slug: recipe.slug,
            max: maxCraftQty,
            labels: {
                craft_button: 'game.crafting.queue.craft_button'|trans,
                crafting_progress: 'game.crafting.queue.crafting_progress'|trans,
                crafted_done: 'game.crafting.queue.crafted_done'|trans,
                connection_error: 'game.crafting.queue.connection_error'|trans,
            },
        }) }}>
        {% if canCraftRecipe and maxCraftQty > 1 %}
            <div class="flex items-center gap-1.5 mb-2">
                <button type="button" data-action="craft-queue#decrement"
                        class="ds-btn ds-btn--secondary ds-btn--sm w-7 min-h-0 h-7 px-0">-</button>
                <input type="number" min="1" max="{{ maxCraftQty }}" value="1"
                       data-craft-queue-target="quantityInput"
                       class="w-12 h-7 text-center ds-num bg-paper text-ink rounded-card border border-line focus:border-brand focus:outline-hidden [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none">
                <button type="button" data-action="craft-queue#increment"
                        class="ds-btn ds-btn--secondary ds-btn--sm w-7 min-h-0 h-7 px-0">+</button>
                <button type="button" data-action="craft-queue#setMax"
                        data-craft-queue-target="maxBadge"
                        class="ds-seal ds-seal-epic cursor-pointer">
                    Max ({{ maxCraftQty }})
                </button>
            </div>
        {% elseif canCraftRecipe %}
            <input type="hidden" value="1" data-craft-queue-target="quantityInput">
        {% else %}
            <input type="hidden" value="0" data-craft-queue-target="quantityInput">
        {% endif %}

        <button type="button"
                data-craft-queue-target="button"
                data-action="craft-queue#craft"
                class="ds-btn w-full {{ canCraftRecipe ? 'ds-btn--primary' : 'ds-btn--disabled' }}"
                {% if not canCraftRecipe %}disabled{% endif %}>
            <span data-craft-queue-target="buttonText">
                {% if canCraftRecipe %}
                    Fabriquer
                {% else %}
                    Ingredients manquants
                {% endif %}
            </span>
        </button>
    </div>
</div>
