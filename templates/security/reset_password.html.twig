{# ONB-02 — le mot de passe oublie, second ecran : le nouveau mot de passe.

   On n'arrive ici qu'avec un jeton valide (le controleur a deja redirige tout
   le reste). La regle de longueur est celle de l'inscription : reinitialiser
   ne doit pas decouvrir une autre politique que celle du premier jour. #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'security.reset.title'|trans }}{% endblock %}

{% block body %}
<div class="flex items-center justify-center min-h-[calc(100vh-4rem)] px-4 py-12">
    <div class="w-full max-w-md">
        <div class="ds-card">
            <h1 class="ds-title">{{ 'security.reset.new_password_title'|trans }}</h1>
            <p class="ds-hint mt-1 mb-6">{{ 'security.reset.new_password_subtitle'|trans }}</p>

            {% for message in app.flashes('error') %}
                <div class="ds-banner ds-banner--loss mb-4">{{ message|trans }}</div>
            {% endfor %}

            <form method="post" class="space-y-4" data-turbo="false">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}">

                <div>
                    <label for="inputPassword" class="ds-label ds-label--field">{{ 'security.reset.new_password'|trans }}</label>
                    <input type="password" name="password" id="inputPassword" class="ds-field"
                           placeholder="••••••••" autocomplete="new-password" required autofocus
                           minlength="{{ password_min_length }}">
                    <p class="ds-hint mt-1">{{ 'registration.password_hint'|trans({'%min%': password_min_length}) }}</p>
                </div>

                {# Une seule action primaire par ecran. #}
                <button type="submit" class="ds-btn ds-btn--primary w-full">{{ 'security.reset.confirm'|trans }}</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
