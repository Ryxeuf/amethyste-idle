{# ONB-18 — l'ecran de connexion au systeme « Parchemin ».

   C'est le **premier ecran du jeu**, et c'etait le seul a ne pas lui
   ressembler : ardoise, violet vif, champs a icone, un bouton qui redeclarait
   ses propres couleurs. Trois regles du systeme s'y appliquent desormais —
   une seule action primaire, aucune couleur redeclaree, un etat qui dit quoi
   faire. #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'security.title'|trans }}{% endblock %}

{% block body %}
<div class="flex items-center justify-center min-h-[calc(100vh-4rem)] px-4 py-12">
    <div class="w-full max-w-md">
        <div class="ds-card">
            <h1 class="ds-title">{{ 'security.title'|trans }}</h1>
            <p class="ds-hint mt-1 mb-6">{{ 'security.subtitle'|trans }}</p>

            {% for message in app.flashes('error') %}
                <div class="ds-banner ds-banner--loss mb-4">{{ message }}</div>
            {% endfor %}

            {% if error %}
                <div class="ds-banner ds-banner--loss mb-4">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}
                <div class="ds-panel mb-4">
                    <p class="text-sm text-ink">{{ 'security.logged_in_as'|trans({'%username%': app.user.userIdentifier}) }}</p>
                    <a href="{{ path('app_logout') }}" class="ds-btn ds-btn--quiet ds-btn--sm mt-2">{{ 'security.logout'|trans }}</a>
                </div>
            {% endif %}

            {# Turbo intercepte le POST en fetch() : la session / le 302 de login peuvent échouer sans rechargement complet #}
            <form method="post" class="space-y-4" data-turbo="false">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div>
                    <label for="inputEmail" class="ds-label ds-label--field">{{ 'security.email'|trans }}</label>
                    <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="ds-field"
                           placeholder="{{ 'security.email_placeholder'|trans }}" autocomplete="email" required autofocus>
                </div>

                <div>
                    <label for="inputPassword" class="ds-label ds-label--field">{{ 'security.password'|trans }}</label>
                    <input type="password" name="password" id="inputPassword" class="ds-field"
                           placeholder="••••••••" autocomplete="current-password" required>
                </div>

                <label for="rememberMe" class="flex items-center gap-2 cursor-pointer select-none">
                    <input type="checkbox" name="_remember_me" id="rememberMe" class="w-4 h-4 accent-brand">
                    <span class="text-sm text-ink">{{ 'security.remember_me'|trans }}</span>
                </label>

                {# Une seule action primaire par ecran. #}
                <button type="submit" class="ds-btn ds-btn--primary w-full">{{ 'security.login'|trans }}</button>
            </form>

            <div class="ds-divider my-6"></div>

            <p class="ds-hint text-center">
                {{ 'security.no_account'|trans }}
                <a href="{{ path('app_register') }}" class="underline">{{ 'security.register_link'|trans }}</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}
