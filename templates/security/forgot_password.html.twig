{# ONB-02 — le mot de passe oublie, premier ecran : la demande.

   L'ecran repond la meme chose que l'adresse ait un compte ou non — un seul
   message de confirmation, jamais « cette adresse est inconnue ». Dire
   l'inverse offrirait l'annuaire des comptes a qui veut le sonder. #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'security.reset.title'|trans }}{% endblock %}

{% block body %}
<div class="flex items-center justify-center min-h-[calc(100vh-4rem)] px-4 py-12">
    <div class="w-full max-w-md">
        <div class="ds-card">
            <h1 class="ds-title">{{ 'security.reset.title'|trans }}</h1>
            <p class="ds-hint mt-1 mb-6">{{ 'security.reset.subtitle'|trans }}</p>

            {% for message in app.flashes('error') %}
                <div class="ds-banner ds-banner--loss mb-4">{{ message|trans }}</div>
            {% endfor %}

            {% if sent %}
                {# L'etat de succes remplace le formulaire : le geste est fait,
                   le prochain pas est dans la boite aux lettres. #}
                <div class="ds-panel mb-4">
                    <p class="text-sm text-ink">{{ 'security.reset.request_sent'|trans }}</p>
                </div>
                <p class="ds-hint text-center">
                    <a href="{{ path('app_login') }}" class="underline">{{ 'security.reset.back_to_login'|trans }}</a>
                </p>
            {% else %}
                <form method="post" class="space-y-4" data-turbo="false">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">

                    <div>
                        <label for="inputEmail" class="ds-label ds-label--field">{{ 'security.email'|trans }}</label>
                        <input type="email" name="email" id="inputEmail" class="ds-field"
                               placeholder="{{ 'security.email_placeholder'|trans }}" autocomplete="email" required autofocus>
                    </div>

                    {# Une seule action primaire par ecran. #}
                    <button type="submit" class="ds-btn ds-btn--primary w-full">{{ 'security.reset.submit'|trans }}</button>
                </form>

                <div class="ds-divider my-6"></div>

                <p class="ds-hint text-center">
                    <a href="{{ path('app_login') }}" class="underline">{{ 'security.reset.back_to_login'|trans }}</a>
                </p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
