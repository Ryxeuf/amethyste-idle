{# ONB-02 — l'e-mail de reinitialisation. Au ton du jeu, en francais via le
   catalogue (le repli texte vit dans password_reset.txt.twig). Aucun style
   externe : un e-mail se lit partout ou il arrive. #}
<div style="font-family: Georgia, 'Times New Roman', serif; max-width: 560px; margin: 0 auto; padding: 24px; color: #2b2118;">
    <h1 style="font-size: 20px; margin-bottom: 16px;">{{ 'security.reset.email.title'|trans }}</h1>

    <p style="line-height: 1.6;">{{ 'security.reset.email.intro'|trans }}</p>

    <p style="margin: 24px 0; text-align: center;">
        <a href="{{ reset_url }}"
           style="display: inline-block; padding: 12px 24px; background: #6d28d9; color: #ffffff; text-decoration: none; border-radius: 6px;">
            {{ 'security.reset.email.action'|trans }}
        </a>
    </p>

    <p style="line-height: 1.6;">{{ 'security.reset.email.expiry'|trans }}</p>

    <p style="line-height: 1.6;">{{ 'security.reset.email.ignore'|trans }}</p>

    <p style="line-height: 1.6; word-break: break-all; font-size: 12px; color: #6b5d4f;">{{ reset_url }}</p>
</div>
