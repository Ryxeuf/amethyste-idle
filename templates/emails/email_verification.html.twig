{# ONB-04 — l'e-mail de verification (et ses rappels J+1/J+3). Meme sobriete
   que le mot de passe oublie : un e-mail se lit partout ou il arrive. #}
<div style="font-family: Georgia, 'Times New Roman', serif; max-width: 560px; margin: 0 auto; padding: 24px; color: #2b2118;">
    <h1 style="font-size: 20px; margin-bottom: 16px;">{{ 'security.verification.email.title'|trans }}</h1>

    {% if reminder %}
        <p style="line-height: 1.6;">{{ 'security.verification.email.reminder_intro'|trans }}</p>
    {% else %}
        <p style="line-height: 1.6;">{{ 'security.verification.email.intro'|trans }}</p>
    {% endif %}

    <p style="margin: 24px 0; text-align: center;">
        <a href="{{ verify_url }}"
           style="display: inline-block; padding: 12px 24px; background: #6d28d9; color: #ffffff; text-decoration: none; border-radius: 6px;">
            {{ 'security.verification.email.action'|trans }}
        </a>
    </p>

    <p style="line-height: 1.6;">{{ 'security.verification.email.what_it_opens'|trans }}</p>

    <p style="line-height: 1.6;">{{ 'security.verification.email.ignore'|trans }}</p>

    <p style="line-height: 1.6; word-break: break-all; font-size: 12px; color: #6b5d4f;">{{ verify_url }}</p>
</div>
